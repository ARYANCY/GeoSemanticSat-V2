  <!-- LAYER 1: GNOME Palette Primitives -->
  <Color x:Key="GnomeDarkWindow">#242424</Color>
  <Color x:Key="GnomeDarkHeader">#2A2A2A</Color>
  <Color x:Key="GnomeDarkCard">#303030</Color>
  <Color x:Key="GnomeDarkCardHover">#383838</Color>
  <Color x:Key="GnomeDarkInset">#1E1E1E</Color>
  <Color x:Key="GnomeDarkSunken">#181818</Color>

  <Color x:Key="GnomeBorder">#383838</Color>
  <Color x:Key="GnomeBorderStrong">#4A4A4A</Color>

  <Color x:Key="GnomeBlue3">#3584E4</Color>
  <Color x:Key="GnomeBlue4">#1C71D8</Color>
  <Color x:Key="GnomeBlueSurface">#14325C</Color>

  <Color x:Key="GnomeGreen3">#33D17A</Color>
  <Color x:Key="GnomeGreen4">#2EC27E</Color>
  <Color x:Key="GnomeGreenSurface">#123620</Color>

  <Color x:Key="GnomeOrange3">#FF7800</Color>
  <Color x:Key="GnomeYellow3">#F6D32D</Color>
  <Color x:Key="GnomeOrangeSurface">#3D2104</Color>

  <Color x:Key="GnomeRed3">#E01B24</Color>
  <Color x:Key="GnomeRed4">#C01C28</Color>
  <Color x:Key="GnomeRedSurface">#3D1014</Color>

  <Color x:Key="GnomeLight1">#FFFFFF</Color>
  <Color x:Key="GnomeLight2">#DEDDDA</Color>
  <Color x:Key="GnomeLight3">#C0BFBC</Color>
  <Color x:Key="GnomeGray1">#9A9996</Color>
  <Color x:Key="GnomeGray2">#77767B</Color>

  <!-- LAYER 2: Semantic Theme Vocabulary -->
  <!-- Surfaces -->
  <SolidColorBrush x:Key="AppBackgroundBrush"  Color="{StaticResource GnomeDarkWindow}"/>
  <SolidColorBrush x:Key="SurfaceBrush"        Color="{StaticResource GnomeDarkHeader}"/>
  <SolidColorBrush x:Key="SurfaceRaisedBrush"  Color="{StaticResource GnomeDarkCard}"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush"   Color="{StaticResource GnomeDarkCardHover}"/>
  <SolidColorBrush x:Key="SurfaceInsetBrush"   Color="{StaticResource GnomeDarkInset}"/>
  <SolidColorBrush x:Key="SurfaceSunkenBrush"  Color="{StaticResource GnomeDarkSunken}"/>

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource GnomeLight1}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource GnomeLight2}"/>
  <SolidColorBrush x:Key="TextMutedBrush"      Color="{StaticResource GnomeLight3}"/>
  <SolidColorBrush x:Key="TextFaintBrush"      Color="{StaticResource GnomeGray1}"/>
  <SolidColorBrush x:Key="TextOnAccentBrush"   Color="#FFFFFF"/>

  <!-- Rules and dividers -->
  <SolidColorBrush x:Key="RuleBrush"           Color="{StaticResource GnomeBorder}"/>
  <SolidColorBrush x:Key="RuleStrongBrush"     Color="{StaticResource GnomeBorderStrong}"/>

  <!-- Accents -->
  <SolidColorBrush x:Key="AccentBrush"         Color="{StaticResource GnomeBlue3}"/>
  <SolidColorBrush x:Key="AccentPressedBrush"  Color="{StaticResource GnomeBlue4}"/>
  <SolidColorBrush x:Key="AccentDeepBrush"     Color="{StaticResource GnomeBlue4}"/>
  <SolidColorBrush x:Key="AccentSurfaceBrush"  Color="{StaticResource GnomeBlueSurface}"/>

  <!-- Status / Verification -->
  <SolidColorBrush x:Key="VerifiedBrush"        Color="{StaticResource GnomeGreen3}"/>
  <SolidColorBrush x:Key="VerifiedSurfaceBrush" Color="{StaticResource GnomeGreenSurface}"/>
  <SolidColorBrush x:Key="CandidateBrush"       Color="{StaticResource GnomeOrange3}"/>
  <SolidColorBrush x:Key="CandidateSurfaceBrush" Color="{StaticResource GnomeOrangeSurface}"/>
  <SolidColorBrush x:Key="RejectedBrush"        Color="{StaticResource GnomeRed3}"/>
  <SolidColorBrush x:Key="RejectedSurfaceBrush" Color="{StaticResource GnomeRedSurface}"/>
  <SolidColorBrush x:Key="AlertBrush"           Color="{StaticResource GnomeRed3}"/>

  <!-- Map canvas -->
  <SolidColorBrush x:Key="MapVoidBrush"        Color="#141920"/>
  <SolidColorBrush x:Key="MapLandBrush"        Color="#1A222C"/>
  <SolidColorBrush x:Key="MapLandAltBrush"     Color="#202A36"/>

  <!-- TYPE SCALE (GNOME HIG) -->
