      <SolidColorBrush x:Key="RuleStrongBrush"     Color="{StaticResource DarkGraphite600}"/>

      <!-- Accent -->
      <SolidColorBrush x:Key="AccentBrush"         Color="{StaticResource DarkCyan400}"/>
      <SolidColorBrush x:Key="AccentPressedBrush"  Color="{StaticResource DarkCyan500}"/>
      <SolidColorBrush x:Key="AccentDeepBrush"     Color="{StaticResource DarkCyan500}"/>
      <SolidColorBrush x:Key="AccentSurfaceBrush"  Color="{StaticResource DarkCyan950}"/>

      <!-- Workflow states -->
      <SolidColorBrush x:Key="VerifiedBrush"        Color="{StaticResource DarkMint400}"/>
      <SolidColorBrush x:Key="VerifiedSurfaceBrush" Color="{StaticResource DarkMint950}"/>
      <SolidColorBrush x:Key="CandidateBrush"       Color="{StaticResource DarkAmber400}"/>
      <SolidColorBrush x:Key="CandidateSurfaceBrush" Color="{StaticResource DarkAmber950}"/>
      <SolidColorBrush x:Key="RejectedBrush"        Color="{StaticResource DarkRose400}"/>
      <SolidColorBrush x:Key="RejectedSurfaceBrush" Color="{StaticResource DarkRose950}"/>
      <SolidColorBrush x:Key="AlertBrush"           Color="{StaticResource DarkRose400}"/>

      <!-- Map canvas -->
      <SolidColorBrush x:Key="MapVoidBrush"        Color="#0B1520"/>
      <SolidColorBrush x:Key="MapLandBrush"        Color="#10202D"/>
      <SolidColorBrush x:Key="MapLandAltBrush"     Color="#122634"/>
    </ResourceDictionary>
