<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==============================================================
       DESIGN TOKENS . single source of truth
       Views reference the LAYER 2 semantic names only, never a hex
       value and never a primitive. Changing the accent is one edit here.
       ============================================================== -->

  <!-- LAYER 1 . primitives. Never referenced from a view. -->
  <Color x:Key="Graphite950">#0D0F13</Color>
  <Color x:Key="Graphite900">#14171C</Color>
  <Color x:Key="Graphite850">#181C22</Color>
  <Color x:Key="Graphite800">#1E232A</Color>
  <Color x:Key="Graphite700">#2A303A</Color>
  <Color x:Key="Graphite600">#3A424F</Color>
  <Color x:Key="Graphite400">#78828F</Color>
  <Color x:Key="Graphite300">#A6AEBA</Color>
  <Color x:Key="Graphite200">#CDD3DB</Color>
  <Color x:Key="Graphite050">#F4F6F8</Color>

  <Color x:Key="Cyan400">#38BDF8</Color>
  <Color x:Key="Cyan500">#0EA5E9</Color>
  <Color x:Key="Cyan950">#0A2536</Color>

  <Color x:Key="Mint400">#34D399</Color>
  <Color x:Key="Mint950">#0A2A20</Color>
  <Color x:Key="Rose400">#FB7185</Color>
  <Color x:Key="Rose950">#33141B</Color>
  <Color x:Key="Amber400">#FBBF24</Color>
  <Color x:Key="Amber950">#2E2208</Color>

  <!-- LAYER 2 . semantic. This is the vocabulary views use. -->

  <!-- Surfaces -->
  <SolidColorBrush x:Key="AppBackgroundBrush"  Color="{StaticResource Graphite950}"/>
  <SolidColorBrush x:Key="SurfaceBrush"        Color="{StaticResource Graphite900}"/>
  <SolidColorBrush x:Key="SurfaceRaisedBrush"  Color="{StaticResource Graphite850}"/>
  <SolidColorBrush x:Key="SurfaceInsetBrush"   Color="{StaticResource Graphite800}"/>
  <SolidColorBrush x:Key="SurfaceSunkenBrush"  Color="{StaticResource Graphite950}"/>

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource Graphite050}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource Graphite200}"/>
  <SolidColorBrush x:Key="TextMutedBrush"      Color="{StaticResource Graphite300}"/>
  <SolidColorBrush x:Key="TextFaintBrush"      Color="{StaticResource Graphite400}"/>
  <SolidColorBrush x:Key="TextOnAccentBrush"   Color="{StaticResource Graphite950}"/>

  <!-- Rules and dividers -->
  <SolidColorBrush x:Key="RuleBrush"           Color="{StaticResource Graphite700}"/>
  <SolidColorBrush x:Key="RuleStrongBrush"     Color="{StaticResource Graphite600}"/>

  <!-- One accent. Everything that needs a human uses this and nothing else. -->
  <SolidColorBrush x:Key="AccentBrush"         Color="{StaticResource Cyan400}"/>
  <SolidColorBrush x:Key="AccentPressedBrush"  Color="{StaticResource Cyan500}"/>
  <SolidColorBrush x:Key="AccentDeepBrush"     Color="{StaticResource Cyan500}"/>
  <SolidColorBrush x:Key="AccentSurfaceBrush"  Color="{StaticResource Cyan950}"/>

  <!-- Workflow states. See CONTEXT.md: Result, Candidate, Verified. -->
  <SolidColorBrush x:Key="VerifiedBrush"        Color="{StaticResource Mint400}"/>
  <SolidColorBrush x:Key="VerifiedSurfaceBrush" Color="{StaticResource Mint950}"/>
  <SolidColorBrush x:Key="CandidateBrush"       Color="{StaticResource Amber400}"/>
  <SolidColorBrush x:Key="CandidateSurfaceBrush" Color="{StaticResource Amber950}"/>
  <SolidColorBrush x:Key="RejectedBrush"        Color="{StaticResource Rose400}"/>
  <SolidColorBrush x:Key="RejectedSurfaceBrush" Color="{StaticResource Rose950}"/>
  <SolidColorBrush x:Key="AlertBrush"           Color="{StaticResource Rose400}"/>

  <!-- Map canvas -->
  <SolidColorBrush x:Key="MapVoidBrush"        Color="#0B1520"/>
  <SolidColorBrush x:Key="MapLandBrush"        Color="#10202D"/>
  <SolidColorBrush x:Key="MapLandAltBrush"     Color="#122634"/>

  <!-- TYPE SCALE
       12 is the floor. Below that, text is unreadable once a laptop is
       mirrored to a projector, which is how this gets demonstrated. -->
  <x:Double x:Key="FontMicro">12</x:Double>
  <x:Double x:Key="FontBody">13</x:Double>
  <x:Double x:Key="FontBodyLg">15</x:Double>
  <x:Double x:Key="FontTitle">18</x:Double>
  <x:Double x:Key="FontDisplay">26</x:Double>

  <FontFamily x:Key="UiFont">Inter, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, monospace</FontFamily>

  <!-- SPACING . 4px rhythm -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">24</x:Double>
  <x:Double x:Key="Space6">32</x:Double>

  <Thickness x:Key="PadCard">16</Thickness>
  <Thickness x:Key="PadZone">20,16</Thickness>

  <CornerRadius x:Key="RadiusNone">0</CornerRadius>
</ResourceDictionary>
