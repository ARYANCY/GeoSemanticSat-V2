<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:controls="clr-namespace:GeoSemanticSat.UI.Controls"
                 xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
                 xmlns:licon="clr-namespace:LucideAvalonia.Enum;assembly=LucideAvalonia"
                 x:Class="GeoSemanticSat.UI.MainWindow"
                 Title="GeoSemanticSat - Earth Observation Intelligence Studio"
                 Width="1440" Height="920"
                 MinWidth="960" MinHeight="640"
                 WindowState="Maximized"
                 WindowStartupLocation="CenterScreen"
                 BackgroundStyle="Flat"
                 BackgroundAnimationEnabled="False"
                 BackgroundTransitionsEnabled="False"
                 ShowBottomBorder="False"
                 CanPin="False"
                 RootCornerRadius="8"
                 TitleFontSize="12"
                 TitleFontWeight="Normal"
                 DragDrop.AllowDrop="True"
                 KeyDown="OnWindowKeyDown">

    <!-- ==================================================================
         WINDOW CHROME
         Branding and global actions live in the real title bar rather than
         in a second app-drawn bar underneath it. Previously both existed:
         an empty 66px system title bar stacked on a 50px header bar that
         repeated the app name, which is what made the shell look misaligned
         with its own content.
         ================================================================== -->
    <suki:SukiWindow.LogoContent>
        <Border Background="{DynamicResource AccentSurfaceBrush}"
                CornerRadius="{DynamicResource RadiusControl}"
                Width="24" Height="24" Margin="4,0,2,0"
                ToolTip.Tip="GeoSemanticSat &#x2014; Earth Observation Intelligence &amp; Multi-Temporal Change Studio">
            <lucide:Lucide Icon="{x:Static licon:LucideIconNames.Satellite}" Width="14" Height="14"
                           StrokeBrush="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </suki:SukiWindow.LogoContent>

    <suki:SukiWindow.RightWindowTitleBarControls>
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,8,0">
            <Button x:Name="BtnLoadGeoTiff" Classes="flat" Click="OnLoadGeoTiffClicked" Padding="9,4" MinHeight="28"
                    ToolTip.Tip="Ingest an external GeoTIFF multi-band satellite raster (Ctrl+O, or Drag &amp; Drop)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:Lucide Icon="{x:Static licon:LucideIconNames.Import}" Width="14" Height="14" StrokeThickness="2" StrokeBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Ingest" FontSize="{DynamicResource FontMicro}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnQuickBenchmark" Classes="flat" Click="OnRunBenchmarkClicked" Padding="9,4" MinHeight="28"
                    ToolTip.Tip="Run the automated multi-temporal evaluation benchmark suite (F5)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:Lucide Icon="{x:Static licon:LucideIconNames.CirclePlay}" Width="14" Height="14" StrokeThickness="2" StrokeBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBenchmarkLabel" Text="Benchmark" FontSize="{DynamicResource FontMicro}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnHelpGuide" Classes="flat" Click="OnHelpGuideClicked" Padding="9,4" MinHeight="28"
                    ToolTip.Tip="Analyst documentation and keyboard shortcuts (F1)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:Lucide Icon="{x:Static licon:LucideIconNames.BookOpen}" Width="14" Height="14" StrokeThickness="2" StrokeBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtHelpLabel" Text="Help" FontSize="{DynamicResource FontMicro}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="16" MaxWidth="360">
                            <StackPanel Spacing="12">
                                <TextBlock Text="KEYBOARD SHORTCUTS" Classes="sectionHeader"/>
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="96, *">
                                        <Border Grid.Column="0" Classes="badge" HorizontalAlignment="Left"><TextBlock Text="Ctrl + 1..5" Classes="mono"/></Border>
                                        <TextBlock Grid.Column="1" Text="Switch workflow stages" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="96, *">
                                        <Border Grid.Column="0" Classes="badge" HorizontalAlignment="Left"><TextBlock Text="Ctrl + O" Classes="mono"/></Border>
                                        <TextBlock Grid.Column="1" Text="Ingest GeoTIFF raster" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="96, *">
                                        <Border Grid.Column="0" Classes="badge" HorizontalAlignment="Left"><TextBlock Text="Ctrl + F" Classes="mono"/></Border>
                                        <TextBlock Grid.Column="1" Text="Focus semantic search" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="96, *">
                                        <Border Grid.Column="0" Classes="badge" HorizontalAlignment="Left"><TextBlock Text="F5" Classes="mono"/></Border>
                                        <TextBlock Grid.Column="1" Text="Run benchmark suite" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="96, *">
                                        <Border Grid.Column="0" Classes="badge" HorizontalAlignment="Left"><TextBlock Text="M / F" Classes="mono"/></Border>
                                        <TextBlock Grid.Column="1" Text="Map fit all / Fullscreen" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="96, *">
                                        <Border Grid.Column="0" Classes="badge" HorizontalAlignment="Left"><TextBlock Text="C / R / N" Classes="mono"/></Border>
                                        <TextBlock Grid.Column="1" Text="Confirm / Reject / Review" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="96, *">
                                        <Border Grid.Column="0" Classes="badge" HorizontalAlignment="Left"><TextBlock Text="Esc" Classes="mono"/></Border>
                                        <TextBlock Grid.Column="1" Text="Exit fullscreen / modal" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </suki:SukiWindow.RightWindowTitleBarControls>

    <Panel x:Name="RootWindowPanel" Background="{DynamicResource SurfaceBrush}">

        <!-- MAIN WINDOW GRID: HEADERBAR (ROW 0) + CONTENT STATIONS (ROW 1) + STATUSBAR (ROW 2) -->
        <Grid RowDefinitions="Auto, *, Auto">

            <!-- ==============================================================
                 WORKFLOW BAR (ROW 0)
                 One job only: where am I in the five-stage pipeline, and what
                 is next. Branding and global actions moved up into the real
                 title bar, so this bar no longer duplicates window chrome.
                 ============================================================== -->
            <Border Grid.Row="0" Classes="headerbar">
                <Grid ColumnDefinitions="Auto, *, Auto">

                    <!-- Left: current stage, spelled out. -->
                    <TextBlock Grid.Column="0" x:Name="TxtStageCaption" Text="STAGE 1 &#x2014; FIND IMAGES"
                               Classes="sectionHeader" VerticalAlignment="Center" Margin="2,0,12,0" />

                    <!-- Center: View Switcher (Linked Segmented Group) -->
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceInsetBrush}"
                            BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusControl}" Padding="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="1">

                            <!-- View 1: Discover Concepts -->
                            <Button x:Name="BtnStep1" Click="OnNavigateToStepClicked" Tag="0" Classes="stage current" ToolTip.Tip="Step 1: Discover concepts using natural language" Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Border x:Name="BadgeStep1Icon" Width="17" Height="17" CornerRadius="4" Background="{DynamicResource AccentBrush}">
                                        <TextBlock Text="1" FontSize="{DynamicResource FontMicro}" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="TxtStep1Label" Text="Explore" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border x:Name="ChipStep1Count" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="BadgeStep1Count" Text="{Binding Step1Count, FallbackValue=0}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- View 2: Target Coordinates -->
                            <Button x:Name="BtnStep2" Click="OnNavigateToStepClicked" Tag="1" Classes="stage" ToolTip.Tip="Step 2: Spatiotemporal search by coordinate radius and date" Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Border x:Name="BadgeStep2Icon" Width="17" Height="17" CornerRadius="4" Background="{DynamicResource SurfaceRaisedBrush}">
                                        <TextBlock Text="2" FontSize="{DynamicResource FontMicro}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="TxtStep2Label" Text="Target" FontSize="{DynamicResource FontBody}" FontWeight="Normal" VerticalAlignment="Center" />
                                    <Border x:Name="ChipStep2Count" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="BadgeStep2Count" Text="{Binding Step2Count, FallbackValue=0}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- View 3: Spectral Verification -->
                            <Button x:Name="BtnStep3" Click="OnNavigateToStepClicked" Tag="2" Classes="stage" ToolTip.Tip="Step 3: Multi-temporal CVA and calibrated spectral analysis" Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Border x:Name="BadgeStep3Icon" Width="17" Height="17" CornerRadius="4" Background="{DynamicResource SurfaceRaisedBrush}">
                                        <TextBlock Text="3" FontSize="{DynamicResource FontMicro}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="TxtStep3Label" Text="Spectral" FontSize="{DynamicResource FontBody}" FontWeight="Normal" VerticalAlignment="Center" />
                                    <Border x:Name="ChipStep3Count" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="BadgeStep3Count" Text="{Binding Step3Count, FallbackValue=0}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- View 4: Group Facilities -->
                            <Button x:Name="BtnStep4" Click="OnNavigateToStepClicked" Tag="3" Classes="stage" ToolTip.Tip="Step 4: Spatial-semantic clustering for complex facilities" Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Border x:Name="BadgeStep4Icon" Width="17" Height="17" CornerRadius="4" Background="{DynamicResource SurfaceRaisedBrush}">
                                        <TextBlock Text="4" FontSize="{DynamicResource FontMicro}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="TxtStep4Label" Text="Clusters" FontSize="{DynamicResource FontBody}" FontWeight="Normal" VerticalAlignment="Center" />
                                    <Border x:Name="ChipStep4Count" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="BadgeStep4Count" Text="{Binding Step4Count, FallbackValue=0}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- View 5: Audit and Sign Off -->
                            <Button x:Name="BtnStep5" Click="OnNavigateToStepClicked" Tag="4" Classes="stage" ToolTip.Tip="Step 5: Intelligence review queue and W3C PROV-O audit trail" Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Border x:Name="BadgeStep5Icon" Width="17" Height="17" CornerRadius="4" Background="{DynamicResource SurfaceRaisedBrush}">
                                        <TextBlock Text="5" FontSize="{DynamicResource FontMicro}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="TxtStep5Label" Text="Audit" FontSize="{DynamicResource FontBody}" FontWeight="Normal" VerticalAlignment="Center" />
                                    <Border x:Name="ChipStep5Count" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="BadgeStep5Count" Text="{Binding Step5Count, FallbackValue=0}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Right: the single forward action for this stage. -->
                    <Button Grid.Column="2" x:Name="BtnNextStage" Click="OnAdvanceWorkflowClicked" Classes="suggested"
                            Padding="12,5" MinHeight="28" Margin="12,0,2,0" VerticalAlignment="Center"
                            ToolTip.Tip="Advance to next workflow step">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="TxtNextStageLabel" Text="Next" FontSize="{DynamicResource FontMicro}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <lucide:Lucide Icon="{x:Static licon:LucideIconNames.ArrowRight}" Width="13" Height="13" StrokeThickness="2" StrokeBrush="{DynamicResource TextOnAccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ==============================================================
                 OPERATIONAL STATIONS: CHROMELESS TAB CONTROL
                 ============================================================== -->
            <TabControl x:Name="MainTabControl" Classes="chromeless" Grid.Row="1" Margin="14,12,14,12" Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionChanged="OnMainTabSelectionChanged">

                <!-- ==========================================================
                     TAB 1: CONCEPT & SEMANTIC DISCOVERY
                     ========================================================== -->
                <TabItem Header="1. Discover Concepts">
                    <Grid RowDefinitions="Auto, Auto, *" Margin="2">

                        <!-- GNOME Search Entry & Concept Presets -->
                        <Border Grid.Row="0" Classes="card" Margin="0,0,0,10">
                            <StackPanel Spacing="10">
                                <!-- Clean Search Bar -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox x:Name="TxtSearchQuery"
                                             Watermark="Search satellite observations by natural language (e.g., 'newly built structures near a river', 'soil clearance', 'airfield runway')..."
                                             FontSize="{DynamicResource FontBody}" Padding="12,9" />
                                    <Button Grid.Column="1" x:Name="BtnSearch" Classes="suggested" Content="Search Archive"
                                            Margin="8,0,0,0" Padding="18,9" Click="OnSearchClicked" />
                                </Grid>

                                <!-- Suggested Concept Pills & Query Interpretation -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Suggestions:" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextFaintBrush}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                        <Button Classes="chip" Content="Structures near river" Tag="newly built structures near a river" Click="OnQuickQueryClicked" Margin="0,0,6,4" />
                                        <Button Classes="chip" Content="Vehicle concentrations" Tag="large vehicle concentrations on open ground" Click="OnQuickQueryClicked" Margin="0,0,6,4" />
                                        <Button Classes="chip" Content="Airfield and runway" Tag="airfield runway with aircraft" Click="OnQuickQueryClicked" Margin="0,0,6,4" />
                                        <Button Classes="chip" Content="Land clearance" Tag="deforestation or cleared land" Click="OnQuickQueryClicked" Margin="0,0,6,4" />
                                    </WrapPanel>

                                    <!-- AI Interpretation Chip -->
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource RuleBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource RadiusPill}" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock x:Name="TxtInterpretedQuery" Text="AI Target: Physical Terrain &amp; Infrastructure Features" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" MaxWidth="380" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Filter Controls Bar -->
                        <Border Grid.Row="1" Classes="cardCompact onPage" Margin="0,0,0,10">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,16,2" VerticalAlignment="Center">
                                    <TextBlock Text="Sensor:" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ComboBox x:Name="CmbSensorFilter" SelectedIndex="0" Width="140">
                                        <ComboBoxItem Content="All Platforms" />
                                        <ComboBoxItem Content="Sentinel-2 Optical" />
                                        <ComboBoxItem Content="Sentinel-1 SAR" />
                                        <ComboBoxItem Content="Landsat 8/9" />
                                        <ComboBoxItem Content="ISRO Bhuvan" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,16,2" VerticalAlignment="Center">
                                    <TextBlock Text="Visualization:" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ComboBox x:Name="CmbRenderMode" SelectedIndex="0" Width="180" SelectionChanged="OnRenderModeChanged">
                                        <ComboBoxItem Content="True Color (Natural RGB)" />
                                        <ComboBoxItem Content="False Color Infrared (CIR)" />
                                        <ComboBoxItem Content="SWIR Geological (B11/B8/B4)" />
                                        <ComboBoxItem Content="NDVI Vegetation Biomass" />
                                        <ComboBoxItem Content="NDWI Water Boundary" />
                                        <ComboBoxItem Content="NDBI Built-Up Infrastructure" />
                                        <ComboBoxItem Content="SAR Radar Backscatter" />
                                        <ComboBoxItem Content="Thermal IR Heat Radiance" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,16,2" VerticalAlignment="Center">
                                    <TextBlock Text="Sort by:" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ComboBox x:Name="CmbSortOrder" SelectedIndex="0" Width="155" SelectionChanged="OnSortOrderChanged">
                                        <ComboBoxItem Content="Highest Match %" />
                                        <ComboBoxItem Content="Highest Confidence" />
                                        <ComboBoxItem Content="Largest Affected Area" />
                                        <ComboBoxItem Content="Nearest Distance" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Clarification Note -->
                                <TextBlock Text="Result = matches keywords &#x2022; Candidate = change detected &#x2022; Verified = human confirmed"
                                           FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,2,0,2" />
                            </WrapPanel>
                        </Border>

                        <!-- Candidate Results List -->
                        <Border Grid.Row="2" Classes="boxedList">
                            <Grid>
                                <ListBox x:Name="LstSearchResults" Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="OnCandidateSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource RuleBrush}"
                                                    BorderThickness="0,0,0,1" CornerRadius="0" Padding="14,12" Margin="0">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <!-- Thumbnail -->
                                                    <Border Grid.Column="0" Width="104" Height="104" Background="{DynamicResource SurfaceInsetBrush}"
                                                            CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True" Margin="0,0,16,0"
                                                            BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1">
                                                        <Image Source="{Binding ImagePreview}" Stretch="UniformToFill" />
                                                    </Border>

                                                    <!-- Metadata & Evidence -->
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="badge" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SimilarityBadge}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" Classes="heading" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Coordinates}" Classes="mono" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding SpectralInfo}" Classes="mono" Foreground="{DynamicResource TextFaintBrush}" />
                                                    </StackPanel>

                                                    <!-- Candidate Actions -->
                                                    <StackPanel Grid.Column="2" Spacing="5" Width="212" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <Button Content="Target Coordinates (Step 2)" Tag="{Binding PatchId}" Click="OnInspectPatchChangeClicked"
                                                                Classes="quiet" Padding="12,6" FontSize="{DynamicResource FontMicro}" ToolTip.Tip="Transfer coordinates to Step 2 to search by radius and date" />
                                                        <Button Content="Verify Multispectral (Step 3)" Tag="{Binding PatchId}" Click="OnInspectPatchDirectToStep3Clicked"
                                                                Classes="quiet" Padding="12,6" FontSize="{DynamicResource FontMicro}" ToolTip.Tip="Directly open Step 3 to analyze multi-temporal changes in this patch" />
                                                        <Button Content="Find Visually Similar" Tag="{Binding PatchId}" Click="OnFindSimilarClicked"
                                                                Classes="quiet" Padding="12,6" FontSize="{DynamicResource FontMicro}" ToolTip.Tip="Search for other visually similar patches in the archive" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Synchronized Empty / Out-of-Coverage State for Tab 1 -->
                                <Border x:Name="PnlNoDataTab1" IsVisible="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="32">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="520">
                                        <Border Width="48" Height="48" Background="{DynamicResource CandidateSurfaceBrush}" BorderBrush="{DynamicResource CandidateBrush}" BorderThickness="1" CornerRadius="24" HorizontalAlignment="Center">
                                            <lucide:Lucide Icon="{x:Static licon:LucideIconNames.TriangleAlert}" Width="24" Height="24" StrokeThickness="2" StrokeBrush="{DynamicResource CandidateBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="No Matching Observations Found" Classes="heading" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TxtNoDataTab1Detail" Text="No indexed satellite observations match the requested semantic concept in the active archive domain." Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontBody}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                            <Button Content="Show Ingestion Options" Classes="suggested" Click="OnShowMissingDataModalClicked" Padding="12,7" FontSize="{DynamicResource FontBody}" />
                                            <Button Content="Reset to Active Coverage" Click="OnModalResetToActiveCoverageClicked" Padding="12,7" FontSize="{DynamicResource FontBody}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==========================================================
                     TAB 2: TARGET COORDINATE & SPATIOTEMPORAL QUERY
                     ========================================================== -->
                <TabItem Header="2. Target Coordinates">
                    <Grid RowDefinitions="Auto, Auto, *" Margin="2">

                        <!-- Spatiotemporal Parameter Bar -->
                        <Border Grid.Row="0" Classes="card" Margin="0,0,0,8">
                            <StackPanel Spacing="10">
                                <!-- Row 1: Geographic & Semantic Classification -->
                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Width="150" Margin="0,0,10,0">
                                        <TextBlock Text="Center Latitude (&#176;N):" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                        <TextBox x:Name="TxtSearchLat" Text="28.60500" FontSize="{DynamicResource FontBody}" />
                                    </StackPanel>

                                    <StackPanel Width="150" Margin="0,0,10,0">
                                        <TextBlock Text="Center Longitude (&#176;E):" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                        <TextBox x:Name="TxtSearchLon" Text="77.20800" FontSize="{DynamicResource FontBody}" />
                                    </StackPanel>

                                    <StackPanel Width="120" Margin="0,0,10,0">
                                        <TextBlock Text="Radius (km):" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                        <TextBox x:Name="TxtSearchRadius" Text="10.0" FontSize="{DynamicResource FontBody}" />
                                    </StackPanel>

                                    <StackPanel Width="240">
                                        <TextBlock Text="Change Classification:" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                        <ComboBox x:Name="CmbChangeTypeFilter" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="All Supported Types" />
                                            <ComboBoxItem Content="Construction (New Built Structures)" />
                                            <ComboBoxItem Content="Clearance (Vegetation / Earthworks)" />
                                            <ComboBoxItem Content="Water-Extent Variation (Flooding / Drying)" />
                                            <ComboBoxItem Content="Road / Linear Infrastructure" />
                                            <ComboBoxItem Content="Activity Concentration (Vehicles)" />
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Row 2: Temporal Window & Specific Dates -->
                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Width="190" Margin="0,0,10,0">
                                        <TextBlock Text="Time Period Preset:" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                        <ComboBox x:Name="CmbDatePeriodPreset" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnDatePeriodPresetChanged">
                                            <ComboBoxItem Content="All Archive Epochs (2024)" Tag="ALL" />
                                            <ComboBoxItem Content="Q1 2024 (Jan 01 - Mar 31)" Tag="Q1" />
                                            <ComboBoxItem Content="Early Phase (Jan 01 - Feb 15)" Tag="EARLY" />
                                            <ComboBoxItem Content="Disturbance Window (Feb 01 - Mar 25)" Tag="DISTURB" />
                                            <ComboBoxItem Content="Late Phase (Mar 15 - Apr 30)" Tag="LATE" />
                                            <ComboBoxItem Content="Custom Dates (Specific Range)" Tag="CUSTOM" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Width="140" Margin="0,0,10,0">
                                        <TextBlock Text="Start Date (From):" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                        <TextBox x:Name="TxtStartDate" Text="2024-01-01" Watermark="YYYY-MM-DD" FontSize="{DynamicResource FontBody}" />
                                    </StackPanel>

                                    <StackPanel Width="140" Margin="0,0,10,0">
                                        <TextBlock Text="End Date (To):" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                        <TextBox x:Name="TxtEndDate" Text="2024-04-30" Watermark="YYYY-MM-DD" FontSize="{DynamicResource FontBody}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                        <Button x:Name="BtnResetDates" Content="Reset Dates" Click="OnResetDateRangeClicked"
                                                Padding="12,8" FontSize="{DynamicResource FontBody}" ToolTip.Tip="Reset temporal window to entire archive" />
                                        <Button x:Name="BtnExecuteSpatiotemporalSearch" Classes="suggested" Content="Search Changes"
                                                Padding="18,8" FontSize="{DynamicResource FontBody}" Click="OnExecuteSpatiotemporalSearchClicked" ToolTip.Tip="Search physical changes matching coordinates, classification and date range" />
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Row 3: Preset Sector & Timeframe Chips -->
                                <StackPanel Spacing="6">
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="Quick Sectors:" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextFaintBrush}" FontWeight="SemiBold" Margin="0,0,8,2" />
                                        <Button Classes="chip" Content="Sector Alpha (Facility: 28.605 N, 77.208 E)" Tag="28.6050,77.2080,5.0,Construction" Click="OnPresetSectorClicked" Margin="0,0,6,2" />
                                        <Button Classes="chip" Content="Sector Bravo (River: 28.592 N, 77.203 E)" Tag="28.5920,77.2030,5.0,WaterExtentVariation" Click="OnPresetSectorClicked" Margin="0,0,6,2" />
                                        <Button Classes="chip" Content="Sector Charlie (Clearance: 28.604 N, 77.218 E)" Tag="28.6040,77.2180,5.0,Clearance" Click="OnPresetSectorClicked" Margin="0,0,6,2" />
                                    </WrapPanel>

                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="Time Windows:" VerticalAlignment="Center" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextFaintBrush}" FontWeight="SemiBold" Margin="0,0,8,2" />
                                        <Button Classes="chip" Content="Full Archive (Jan 10 - Apr 15)" Tag="2024-01-01,2024-04-30" Click="OnQuickDateClicked" Margin="0,0,6,2" />
                                        <Button Classes="chip" Content="Pre-Onset Baseline (Jan 10 - Feb 04)" Tag="2024-01-01,2024-02-04" Click="OnQuickDateClicked" Margin="0,0,6,2" />
                                        <Button Classes="chip" Content="Active Onset Window (Feb 04 - Mar 20)" Tag="2024-02-01,2024-03-25" Click="OnQuickDateClicked" Margin="0,0,6,2" />
                                        <Button Classes="chip" Content="Post-Disturbance (Mar 20 - Apr 15)" Tag="2024-03-20,2024-04-30" Click="OnQuickDateClicked" Margin="0,0,6,2" />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Spatiotemporal Filter Status Bar -->
                        <Border Grid.Row="1" Classes="cardCompact onPage" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                                <TextBlock Grid.Column="0" x:Name="TxtSearchMatchCount" Text="21 candidates found" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontMicro}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="&#x2022;" Foreground="{DynamicResource RuleStrongBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="TxtSearchActiveCriteria" Text="Radius: 10.0 km around (28.6050&#176;N, 77.2080&#176;E) | Period: 2024-01-01 to 2024-04-30 UTC" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontMicro}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="Temporal filter matches earliest onset or observation window" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- Split View: Geographic Map (Left) + Candidate Before/After Cards (Right) -->
                        <Grid Grid.Row="2" ColumnDefinitions="*, *">
                            <!-- Left: Interactive Map & Before/After Provenance Inspector -->
                            <Border Grid.Column="0" Classes="boxedList" Margin="0,0,6,0">
                                <Grid RowDefinitions="Auto, *, Auto">
                                    <!-- Map Controls Toolbar -->
                                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="6,4" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Text="TARGET SECTOR" Classes="sectionHeader" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <ComboBox x:Name="CmbMapProvider2" SelectedIndex="0" Width="130" SelectionChanged="OnMapProviderChanged">
                                                    <ComboBoxItem Content="Satellite (ArcGIS)" Tag="esri-satellite" />
                                                    <ComboBoxItem Content="Sentinel-2 2024" Tag="sentinel2-cloudless" />
                                                    <ComboBoxItem Content="OpenStreetMap" Tag="osm-standard" />
                                                    <ComboBoxItem Content="USGS" Tag="usgs-imagery" IsEnabled="False" />
                                                </ComboBox>
                                                <ComboBox x:Name="CmbMapMode2" SelectedIndex="0" Width="105" SelectionChanged="OnMapModeChanged">
                                                    <ComboBoxItem Content="Hybrid" Tag="Auto" />
                                                    <ComboBoxItem Content="Air-Gapped" Tag="OfflineStrict" />
                                                    <ComboBoxItem Content="Online" Tag="OnlinePreferred" />
                                                </ComboBox>
                                                <Button Content="Cache" Padding="6,3" FontSize="{DynamicResource FontMicro}" Click="OnPrecacheAoiClicked" ToolTip.Tip="Pre-download map tiles for this target sector for offline deployment" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                                                <Button Content="+" Padding="7,2" FontSize="{DynamicResource FontMicro}" Click="OnMapZoomInClicked" />
                                                <Button Content="-" Padding="7,2" FontSize="{DynamicResource FontMicro}" Click="OnMapZoomOutClicked" />
                                                <Button Content="Fit" Padding="7,2" FontSize="{DynamicResource FontMicro}" Click="OnMapFitAllClicked" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Interactive Map Canvas -->
                                    <controls:InteractiveMapCanvas Grid.Row="1" x:Name="MapCanvasSpatiotemporal" />

                                    <!-- Docked Before & After Provenance Inspector -->
                                    <Grid Grid.Row="2" Margin="0,2,0,0">
                                        <Border x:Name="PnlMapProvenance" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0" Padding="10">
                                            <Grid RowDefinitions="Auto, Auto">
                                                <!-- Header Bar -->
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="6,2">
                                                            <TextBlock Text="PROVENANCE (W3C PROV-O)" Classes="sectionHeader" />
                                                        </Border>
                                                        <TextBlock x:Name="TxtMapProvTitle" Text="Candidate Site #1 | Construction" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontBody}" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtMapProvCoords" Text="28.6050&#176; N, 77.2080&#176; E | 25,600 m&#178;" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontMicro}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                        <Button x:Name="BtnMapProvVerify" Classes="quiet" Content="Deep Verify (Step 3)" Padding="10,4" FontSize="{DynamicResource FontMicro}" Click="OnMapProvDeepVerifyClicked" ToolTip.Tip="Inspect multispectral curves and heatmaps for this site" />
                                                        <Button x:Name="BtnMapProvConfirm" Classes="verify" Content="Confirm" Padding="8,4" FontSize="{DynamicResource FontMicro}" Click="OnMapProvConfirmClicked" ToolTip.Tip="Confirm this physical change" />
                                                        <Button x:Name="BtnMapProvReject" Classes="destructive" Content="Reject" Padding="8,4" FontSize="{DynamicResource FontMicro}" Click="OnMapProvRejectClicked" ToolTip.Tip="Reject as false alarm" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Comparison Body: Baseline T1 vs Observed T2 -->
                                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto, *">
                                                    <!-- Baseline T1 Card -->
                                                    <Border Grid.Column="0" Classes="cardCompact" Margin="0,0,4,0">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <Border Grid.Column="0" Width="72" Height="72" Background="{DynamicResource SurfaceInsetBrush}"
                                                                    CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True" Margin="0,0,8,0">
                                                                <Image x:Name="ImgMapProvBefore" Stretch="UniformToFill" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <Border Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                                    <TextBlock Text="BASELINE (T1)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </Border>
                                                                <TextBlock x:Name="TxtMapProvBeforeDate" Text="2024-01-10 10:30 UTC" FontWeight="Bold" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock x:Name="TxtMapProvBeforeSensor" Text="Sentinel-2A MSI (10m GSD)" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" />
                                                                <TextBlock x:Name="TxtMapProvBeforeScene" Text="Scene: S2A_20240110_T1" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" />
                                                                <TextBlock Text="Level-2A BOA Reflectance" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Center Lineage & Delta Bridge -->
                                                    <Border Grid.Column="1" Classes="cardCompact" Margin="2,0" VerticalAlignment="Center">
                                                        <StackPanel Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="&#x2794; +69 Days" Classes="mono" HorizontalAlignment="Center" />
                                                            <TextBlock x:Name="TxtMapProvOnset" Text="Onset: 2024-02-04 UTC" Classes="mono" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Pipeline: CVA + CUSUM" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="W3C PROV-O Aligned" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" />
                                                            <TextBlock x:Name="TxtMapProvHash" Text="SHA-256: 7f8a92e1..." Classes="mono" FontSize="8" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Observed T2 Card -->
                                                    <Border Grid.Column="2" Classes="cardCompact" Margin="4,0,0,0">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <Border Grid.Column="0" Width="72" Height="72" Background="{DynamicResource SurfaceInsetBrush}"
                                                                    CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True" Margin="0,0,8,0">
                                                                <Image x:Name="ImgMapProvAfter" Stretch="UniformToFill" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <Border Background="{DynamicResource RejectedSurfaceBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                                    <TextBlock Text="OBSERVED (T2)" Classes="sectionHeader" FontSize="9" />
                                                                </Border>
                                                                <TextBlock x:Name="TxtMapProvAfterDate" Text="2024-03-20 10:30 UTC" FontWeight="Bold" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock x:Name="TxtMapProvAfterSensor" Text="Sentinel-2B MSI (10m GSD)" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" />
                                                                <TextBlock x:Name="TxtMapProvAfterScene" Text="Scene: S2B_20240320_T3" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" />
                                                                <TextBlock Text="Level-2A BOA Reflectance" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Out-of-Coverage Notice -->
                                        <Border x:Name="PnlNoDataTab2" IsVisible="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CandidateBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource CandidateSurfaceBrush}" BorderBrush="{DynamicResource CandidateBrush}" BorderThickness="1" CornerRadius="18" Width="36" Height="36">
                                                        <lucide:Lucide Icon="{x:Static licon:LucideIconNames.TriangleAlert}" Width="18" Height="18" StrokeThickness="2" StrokeBrush="{DynamicResource CandidateBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                                        <TextBlock Text="No Satellite Data for Queried Location/Time" FontWeight="SemiBold" FontSize="{DynamicResource FontBody}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock x:Name="TxtNoDataTab2Detail" Text="Queried location/time is outside indexed coverage. Verification views will sync once datasets are ingested." FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Content="Show Dataset Options" Classes="suggested" Click="OnShowMissingDataModalClicked" Padding="10,5" FontSize="{DynamicResource FontMicro}" />
                                                    <Button Content="Reset to Active AOI" Click="OnModalResetToActiveCoverageClicked" Padding="10,5" FontSize="{DynamicResource FontMicro}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Right: Before & After Evidence Cards -->
                            <Border Grid.Column="1" Classes="boxedList" Margin="6,0,0,0">
                                <ListBox x:Name="LstSpatiotemporalResults" Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="OnSpatiotemporalSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RuleBrush}"
                                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="10" Margin="4">
                                                <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                                                    <!-- Baseline T1 -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="Baseline (T1)" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,2" FontWeight="SemiBold" />
                                                        <Border Width="82" Height="82" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True" BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
                                                            <Image Source="{Binding BeforePreview}" Stretch="UniformToFill" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Observed T2 -->
                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                        <TextBlock Text="OBSERVED (T2)" Classes="sectionHeader" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                        <Border Width="82" Height="82" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True" BorderBrush="{DynamicResource RejectedBrush}" BorderThickness="1">
                                                            <Image Source="{Binding AfterPreview}" Stretch="UniformToFill" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Metadata -->
                                                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Border Background="{Binding TypeBadgeColor}" CornerRadius="4" Padding="5,2">
                                                                <TextBlock Text="{Binding ChangeType}" FontWeight="Bold" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontBody}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DistanceInfo}" Classes="mono" />
                                                        <TextBlock Text="{Binding EarliestOnsetInfo}" Classes="mono" />
                                                        <TextBlock Text="{Binding SpectralMetrics}" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>

                                                    <!-- Actions -->
                                                    <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                                                        <Button Content="Deep Verify" Tag="{Binding Id}" Click="OnInspectSpatiotemporalInStep3Clicked"
                                                                Classes="quiet" Padding="8,4" FontSize="{DynamicResource FontMicro}" />
                                                        <Button Content="Confirm" Tag="{Binding Id}" Click="OnConfirmChangeClicked"
                                                                Classes="verify" Padding="8,4" FontSize="{DynamicResource FontMicro}" />
                                                        <Button Content="Reject" Tag="{Binding Id}" Click="OnRejectChangeClicked"
                                                                Classes="destructive" Padding="8,4" FontSize="{DynamicResource FontMicro}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ==========================================================
                     TAB 3: SPECTRAL VERIFICATION STUDIO
                     ========================================================== -->
                <TabItem Header="3. Spectral Verification">
                    <Grid RowDefinitions="Auto, *" Margin="2">

                        <!-- Spectral Mode & Calibration Controls Bar -->
                        <Border Grid.Row="0" Classes="cardCompact onPage" Margin="0,0,0,6">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,14,2">
                                    <TextBlock Text="Spectral Studio" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="&#x2022;" Foreground="{DynamicResource RuleStrongBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Band:" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontMicro}" />
                                    <ComboBox x:Name="CmbChangeSpectralMode" SelectedIndex="0" Width="175" SelectionChanged="OnChangeSpectralModeChanged">
                                        <ComboBoxItem Content="True Color (Natural RGB)" />
                                        <ComboBoxItem Content="False Color Infrared (NIR)" />
                                        <ComboBoxItem Content="SWIR Geological (B11/B8/B4)" />
                                        <ComboBoxItem Content="NDBI Built-Up and Concrete" />
                                        <ComboBoxItem Content="NDVI Vegetation Loss" />
                                        <ComboBoxItem Content="NDWI Water Extent" />
                                        <ComboBoxItem Content="SAR Radar Backscatter" />
                                        <ComboBoxItem Content="Thermal IR Heat Radiance" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,2,14,2">
                                    <CheckBox x:Name="ChkRrn" Content="PIF Calibration" IsChecked="True" FontSize="{DynamicResource FontMicro}" />
                                    <CheckBox x:Name="ChkQualityMask" Content="Cloud Mask" IsChecked="True" FontSize="{DynamicResource FontMicro}" />
                                    <CheckBox x:Name="ChkJitter" Content="Jitter Filter" IsChecked="True" FontSize="{DynamicResource FontMicro}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,0,2">
                                    <Button x:Name="BtnToggleViewMode" Content="Full Scene"
                                            Padding="9,5" FontSize="{DynamicResource FontMicro}"
                                            Click="OnToggleViewModeClicked" ToolTip.Tip="Toggle between High-Res Site Zoom and Full Scene Context" />
                                    <Button x:Name="BtnRunChangeDetection" Classes="suggested" Content="Compute Changes"
                                            Padding="12,5" FontSize="{DynamicResource FontMicro}"
                                            Click="OnRunChangeDetectionClicked" />
                                </StackPanel>
                            </WrapPanel>
                        </Border>

                        <!-- Main Analysis Layout: 64% Left (Visual Verification) + 36% Right (Evidence & Verdict) -->
                        <Grid Grid.Row="1" ColumnDefinitions="64*, 36*">

                            <!-- Synchronized No-Data / Out-of-Coverage Overlay for Tab 3 -->
                            <Border x:Name="PnlNoDataTab3" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="32" ZIndex="100">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="580">
                                    <Border Width="52" Height="52" Background="{DynamicResource CandidateSurfaceBrush}" BorderBrush="{DynamicResource CandidateBrush}" BorderThickness="1" CornerRadius="26" HorizontalAlignment="Center">
                                        <lucide:Lucide Icon="{x:Static licon:LucideIconNames.TriangleAlert}" Width="26" Height="26" StrokeThickness="2" StrokeBrush="{DynamicResource CandidateBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No Satellite Data for Queried Parameters" Classes="heading" HorizontalAlignment="Center" TextAlignment="Center" />
                                    <Border Classes="cardCompact">
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="TxtNoDataTab3Coords" Text="Location: (40.7128&#176;N, -74.0060&#176;E) | Radius: 10.0 km" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="TxtNoDataTab3Dates" Text="Time Window: 2022-01-01 to 2022-12-31 UTC" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Status: Out of indexed satellite coverage. Verification imagery, CVA heatmaps, and spectral curves will appear once datasets covering this location are ingested." FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <Button Content="Show Ingestion Options" Classes="suggested" Click="OnShowMissingDataModalClicked" Padding="14,7" FontSize="{DynamicResource FontBody}" />
                                        <Button Content="Generate Calibrated AOI for Location" Classes="quiet" Click="OnModalGenerateSyntheticSceneClicked" Padding="14,7" FontSize="{DynamicResource FontBody}" />
                                        <Button Content="Reset to Active Coverage" Click="OnModalResetToActiveCoverageClicked" Padding="12,7" FontSize="{DynamicResource FontBody}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Left: Visual Inspection & Per-Candidate Heatmaps -->
                            <Grid Grid.Column="0" RowDefinitions="Auto, 3*, Auto, Auto, *" Margin="0,0,6,0">

                                <!-- Candidate Navigation & Control Toolbar -->
                                <Border Grid.Row="0" Classes="cardCompact onPage" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto">
                                        <Button Grid.Column="0" Content="&#x25C0; Prev" FontSize="{DynamicResource FontMicro}" FontWeight="Bold"
                                                Padding="10,4" Click="OnPrevCandidateClicked" ToolTip.Tip="Previous candidate (Up key)" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCandidateCounter" Text="Candidate 0 of 0"
                                                       FontSize="{DynamicResource FontBody}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="TxtCandidateCoords" Text=""
                                                   FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Border Grid.Column="3" Background="{DynamicResource CandidateSurfaceBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock x:Name="TxtCandidateType" Text=""
                                                       FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CandidateBrush}" VerticalAlignment="Center" />
                                        </Border>
                                        <Button Grid.Column="4" Content="A/B Blink &#x21BB;" FontSize="{DynamicResource FontMicro}" FontWeight="Bold"
                                                Padding="10,4" Margin="0,0,6,0" Click="OnBlinkCompareClicked"
                                                ToolTip.Tip="Rapidly toggle between Baseline T1 and Target T2 imagery to spot changes" />
                                        <Button Grid.Column="5" Content="Next &#x25B6;" FontSize="{DynamicResource FontMicro}" FontWeight="Bold"
                                                Padding="10,4" Click="OnNextCandidateClicked" ToolTip.Tip="Next candidate (Down key)" />
                                    </Grid>
                                </Border>

                                <!-- Primary 3-Panel Synchronized Inspection Station -->
                                <Border Grid.Row="1" Classes="boxedList" Padding="6">
                                    <Grid ColumnDefinitions="*, *, *">
                                        <!-- Panel 1: Baseline T1 -->
                                        <Border Grid.Column="0" Margin="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusControl}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" Padding="6">
                                            <Grid RowDefinitions="Auto, *">
                                                <TextBlock Grid.Row="0" Text="BASELINE &#xB7; T1 &#xB7; 2024-01-10" Classes="sectionHeader" Margin="0,0,0,5" HorizontalAlignment="Center" />
                                                <Border Grid.Row="1" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True">
                                                    <Image x:Name="ImgBaselineT1" Stretch="Uniform" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Panel 2: Target T2 -->
                                        <Border Grid.Column="1" Margin="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusControl}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" Padding="6">
                                            <Grid RowDefinitions="Auto, *">
                                                <TextBlock x:Name="TxtTargetPanelSubtitle" Grid.Row="0" Text="TARGET OBSERVATION &#xB7; T2" Classes="sectionHeader" Margin="0,0,0,5" HorizontalAlignment="Center" />
                                                <Border Grid.Row="1" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True">
                                                    <Image x:Name="ImgTargetT2" Stretch="Uniform" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Panel 3: Change Vector Heatmap Overlay -->
                                        <Border Grid.Column="2" Margin="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusControl}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" Padding="6">
                                            <Grid RowDefinitions="Auto, *, Auto">
                                                <TextBlock x:Name="TxtActiveHeatmapTitle" Grid.Row="0" Text="CVA MAGNITUDE" Classes="sectionHeader" Margin="0,0,0,5" HorizontalAlignment="Center" />
                                                <Border Grid.Row="1" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True">
                                                    <Image x:Name="ImgChangeHeatmap" Stretch="Uniform" />
                                                </Border>
                                                <!-- Colormap Legend Indicator -->
                                                <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="0,3,0,0">
                                                    <TextBlock Grid.Column="0" Text="0.0 Low" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" />
                                                    <TextBlock Grid.Column="1" Text="Turbo Gradient" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="High Peak" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Interactive Multi-Pass CUSUM Timeline -->
                                <Border Grid.Row="2" Classes="cardCompact onPage" Margin="0,4,0,0">
                                    <Grid RowDefinitions="Auto, Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                            <TextBlock Text="MULTI-TEMPORAL PASS SEQUENCE" Classes="sectionHeader" ToolTip.Tip="Click a pass to inspect that observation date" />
                                            <TextBlock x:Name="TxtTimelineOnsetMarker" Grid.Column="1" Text="Onset: &#x2014;" Classes="mono" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *" Margin="0,4,0,0">
                                            <Button Grid.Column="0" Tag="0" Click="OnPassClicked" Margin="2" Padding="4,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <Border x:Name="BorderPass1" CornerRadius="{DynamicResource RadiusControl}" Padding="2">
                                                    <StackPanel>
                                                        <TextBlock Text="Pass 1 | 2024-01-10" FontSize="{DynamicResource FontMicro}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Baseline (0.2&#963;)" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                            <Button Grid.Column="1" Tag="1" Click="OnPassClicked" Margin="2" Padding="4,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <Border x:Name="BorderPass2" CornerRadius="{DynamicResource RadiusControl}" Padding="2">
                                                    <StackPanel>
                                                        <TextBlock Text="Pass 2 | 2024-02-15" FontSize="{DynamicResource FontMicro}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Stable (0.4&#963;)" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                            <Button Grid.Column="2" Tag="2" Click="OnPassClicked" Background="{DynamicResource RejectedSurfaceBrush}" Margin="2" Padding="4,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <Border x:Name="BorderPass3" BorderBrush="{DynamicResource RejectedBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="2">
                                                    <StackPanel>
                                                        <TextBlock Text="Pass 3 | 2024-03-20" FontSize="{DynamicResource FontMicro}" FontWeight="Bold" Foreground="{DynamicResource RejectedBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="ONSET DETECTED (4.8&#963;)" FontSize="9" Foreground="{DynamicResource RejectedBrush}" FontWeight="Bold" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                            <Button Grid.Column="3" Tag="3" Click="OnPassClicked" Margin="2" Padding="4,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <Border x:Name="BorderPass4" CornerRadius="{DynamicResource RadiusControl}" Padding="2">
                                                    <StackPanel>
                                                        <TextBlock Text="Pass 4 | 2024-04-25" FontSize="{DynamicResource FontMicro}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Persistent (5.2&#963;)" FontSize="9" Foreground="{DynamicResource CandidateBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 4 Calibrated Spectral Index Difference Heatmap Cards -->
                                <Border Grid.Row="3" Classes="cardCompact onPage" Margin="0,4,0,0">
                                    <Grid RowDefinitions="Auto, Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="4,0,4,3">
                                            <TextBlock Text="SPECTRAL INDEX DELTAS" Classes="sectionHeader" ToolTip.Tip="Click an index to load it into the main heatmap panel" />
                                            <TextBlock Text="Standard Remote Sensing Scale" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" Grid.Column="1" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *">
                                            <!-- Card 1: &#x0394;NDVI -->
                                            <Button Grid.Column="0" Tag="NDVI" Click="OnSelectSpectralCardClicked" Margin="2" Padding="6" HorizontalAlignment="Stretch">
                                                <Grid RowDefinitions="Auto, Auto, Auto">
                                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="&#x0394;NDVI" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontMicro}" ToolTip.Tip="Normalised Difference Vegetation Index" />
                                                        <TextBlock x:Name="TxtBadgeDeltaNdvi" Grid.Column="1" Text="-0.309" Classes="mono" FontSize="10" Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Grid>
                                                    <Border Grid.Row="1" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True" Height="70" Margin="0,3">
                                                        <Image x:Name="ImgHeatmapNdvi" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Grid.Row="2" Text="Loss &#x25C0; 0 &#x25B6; Growth" FontSize="8" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Button>

                                            <!-- Card 2: &#x0394;NDBI -->
                                            <Button Grid.Column="1" Tag="NDBI" Click="OnSelectSpectralCardClicked" Margin="2" Padding="6" HorizontalAlignment="Stretch">
                                                <Grid RowDefinitions="Auto, Auto, Auto">
                                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="&#x0394;NDBI" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontMicro}" ToolTip.Tip="Normalised Difference Built-up Index" />
                                                        <TextBlock x:Name="TxtBadgeDeltaNdbi" Grid.Column="1" Text="+0.384" Classes="mono" FontSize="10" Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Grid>
                                                    <Border Grid.Row="1" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True" Height="70" Margin="0,3">
                                                        <Image x:Name="ImgHeatmapNdbi" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Grid.Row="2" Text="Demolition &#x25C0; 0 &#x25B6; Built" FontSize="8" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Button>

                                            <!-- Card 3: &#x0394;NDWI -->
                                            <Button Grid.Column="2" Tag="NDWI" Click="OnSelectSpectralCardClicked" Margin="2" Padding="6" HorizontalAlignment="Stretch">
                                                <Grid RowDefinitions="Auto, Auto, Auto">
                                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="&#x0394;NDWI" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontMicro}" ToolTip.Tip="Normalised Difference Water Index" />
                                                        <TextBlock x:Name="TxtBadgeDeltaNdwi" Grid.Column="1" Text="-0.045" Classes="mono" FontSize="10" Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Grid>
                                                    <Border Grid.Row="1" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True" Height="70" Margin="0,3">
                                                        <Image x:Name="ImgHeatmapNdwi" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Grid.Row="2" Text="Drying &#x25C0; 0 &#x25B6; Water" FontSize="8" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Button>

                                            <!-- Card 4: &#x0394;BSI -->
                                            <Button Grid.Column="3" Tag="BSI" Click="OnSelectSpectralCardClicked" Margin="2" Padding="6" HorizontalAlignment="Stretch">
                                                <Grid RowDefinitions="Auto, Auto, Auto">
                                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="&#x0394;BSI" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontMicro}" ToolTip.Tip="Bare Soil Index" />
                                                        <TextBlock x:Name="TxtBadgeDeltaBsi" Grid.Column="1" Text="+0.522" Classes="mono" FontSize="10" Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Grid>
                                                    <Border Grid.Row="1" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True" Height="70" Margin="0,3">
                                                        <Image x:Name="ImgHeatmapBsi" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Grid.Row="2" Text="Stable &#x25C0; 0 &#x25B6; Disturbed" FontSize="8" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Detected Changes Candidate Selector -->
                                <Border Grid.Row="4" Classes="boxedList" Margin="0,4,0,0" MinHeight="75">
                                    <ListBox x:Name="LstChangeResults" Background="Transparent"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="OnChangeSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RuleBrush}"
                                                        BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="6,3" Margin="1">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <Border Grid.Column="0" Background="{Binding TypeBadgeColor}" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Type}" FontWeight="Bold" FontSize="9" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontMicro}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding EarliestObservationText}" Classes="mono" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>

                            <!-- Right 36%: AI Assessment, Evidence Rationale, Spectral Profile & Human Verdict -->
                            <Border Grid.Column="1" Classes="card" Padding="12" Margin="6,0,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="10">

                                        <!-- 1. AI Assessment & Conclusion -->
                                        <Border Classes="cardCompact">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Text="ASSESSMENT" Classes="sectionHeader" />
                                                    <Border Grid.Column="1" x:Name="BadgeAiConfidence" Classes="badge" Background="{DynamicResource SurfaceRaisedBrush}">
                                                        <TextBlock x:Name="TxtAiConfidence" Text="98% Confidence (High)" Classes="mono" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock x:Name="TxtAiClassificationVerdict" Text="Likely Land Clearance / Ground Disturbance" Classes="heading" TextWrapping="Wrap" />

                                                <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                                    <StackPanel Grid.Column="0" Spacing="1">
                                                        <TextBlock Text="AFFECTED AREA" Classes="sectionHeader" FontSize="10" />
                                                        <TextBlock x:Name="TxtAiArea" Text="25,600 m&#178;" Classes="metric" />
                                                        <TextBlock x:Name="TxtAiAreaSecondary" Text="2.56 ha &#xB7; 6.3 acres" Classes="mono" FontSize="10" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="1" Margin="12,0,0,0">
                                                        <TextBlock Text="FIRST DETECTED" Classes="sectionHeader" FontSize="10" />
                                                        <TextBlock x:Name="TxtAiOnset" Text="2024-03-20" Classes="metric" />
                                                        <TextBlock Text="onset pass" Classes="mono" FontSize="10" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. "Why Detected?" Evidence Rationale -->
                                        <Border Classes="cardCompact">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="DETECTION EVIDENCE" Classes="sectionHeader" />
                                                <StackPanel Spacing="3">
                                                    <TextBlock x:Name="TxtEvidVegetation" Text="[+] Significant vegetation loss (Delta NDVI = -0.309)" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtEvidSoil" Text="[+] Bare-soil response increase (Delta BSI = +0.522)" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtEvidPersistence" Text="[+] Multi-temporal persistence verified across 4 passes" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtEvidSpatial" Text="[+] Spatial footprint consistent with ground earthworks" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 3. Multi-Spectral Signature Profile -->
                                        <Border Classes="cardCompact">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Text="SPECTRAL SIGNATURE" Classes="sectionHeader" />
                                                    <TextBlock Text="B2 &#x2022; B3 &#x2022; B4 &#x2022; B8 &#x2022; B11" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" Grid.Column="1" />
                                                </Grid>
                                                <Border Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Height="125" ClipToBounds="True">
                                                    <Image x:Name="ImgSpectralChart" Stretch="Uniform" />
                                                </Border>
                                                <Grid ColumnDefinitions="*, *">
                                                    <TextBlock Text="&#x25CF; T1 Baseline" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" />
                                                    <TextBlock Text="&#x25A0; T2 Target" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Right" Grid.Column="1" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 4. Expandable Technical Diagnostics -->
                                        <Expander Header="Technical Diagnostics &amp; Spectral Indices" Classes="cardCompact">
                                            <StackPanel Spacing="5" Margin="4">
                                                <Grid ColumnDefinitions="*, *">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="Concrete (Delta NDBI):" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextFaintBrush}" />
                                                        <TextBlock x:Name="TxtFocusedDeltaNdbi" Text="+0.384" Classes="monoStrong" FontSize="{DynamicResource FontMicro}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="Biomass Loss (Delta NDVI):" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextFaintBrush}" />
                                                        <TextBlock x:Name="TxtFocusedDeltaNdvi" Text="-0.412" Classes="monoStrong" FontSize="{DynamicResource FontMicro}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid ColumnDefinitions="*, *">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="Water Shift (Delta NDWI):" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextFaintBrush}" />
                                                        <TextBlock x:Name="TxtFocusedDeltaNdwi" Text="-0.045" Classes="monoStrong" FontSize="{DynamicResource FontMicro}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="Edge Gradient (Delta Sobel):" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextFaintBrush}" />
                                                        <TextBlock x:Name="TxtFocusedDeltaGrad" Text="+48.2" Classes="monoStrong" FontSize="{DynamicResource FontMicro}" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Tukey PIF Normalization: Gain 1.04, Offset -0.012" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" Margin="0,4,0,0" />
                                                <TextBlock Text="Sub-pixel Jitter Residual: &#x0394;x = 0.04 px, &#x0394;y = 0.02 px (Passed)" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" />
                                            </StackPanel>
                                        </Expander>

                                        <!-- 5. Analyst Verification & Verdict -->
                                        <Border Classes="cardCompact">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="ANALYST VERDICT" Classes="sectionHeader" />

                                                <Grid ColumnDefinitions="*, *, *">
                                                    <Button Grid.Column="0" x:Name="BtnVerdictConfirm" Classes="verify" Content="Confirm" Click="OnFocusedConfirmClicked" FontSize="{DynamicResource FontMicro}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Confirm candidate into verified intelligence record (Key: C)" />
                                                    <Button Grid.Column="1" x:Name="BtnVerdictReject" Classes="destructive" Content="Reject" Click="OnFocusedRejectClicked" Margin="4,0,4,0" FontSize="{DynamicResource FontMicro}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Reject candidate as false alarm (Key: R)" />
                                                    <Button Grid.Column="2" x:Name="BtnVerdictNeedsReview" Content="Review" Click="OnFocusedNeedsReviewClicked" FontSize="{DynamicResource FontMicro}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Flag for secondary analyst review (Key: N)" />
                                                </Grid>

                                                <TextBox x:Name="TxtAnalystNotes" Watermark="Add analyst verification notes..." FontSize="{DynamicResource FontMicro}" Height="42" TextWrapping="Wrap" />

                                                <Button x:Name="BtnSaveVerdictAndNext" Classes="suggested" Content="Save Verdict and Next Candidate" FontSize="{DynamicResource FontBody}" Padding="10,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnSaveVerdictAndNextClicked" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ==========================================================
                     TAB 4: GROUPED SITES & DEFENSE FACILITIES
                     ========================================================== -->
                <TabItem Header="4. Group Facilities">
                    <Grid RowDefinitions="Auto, *" Margin="2">
                        <Border Grid.Row="0" Classes="card" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Unsupervised Spatial-Semantic Clustering (DBSCAN)" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontBodyLg}" />
                                    <TextBlock Text="Group related physical changes into unified operational facility complexes (compounds, airfields, staging areas) with total geodesic surface area." FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="suggested" Content="Group Archive Sites" Padding="16,8" Click="OnRunClusteringClicked" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="*, *">
                            <!-- Left: Facility Map Canvas -->
                            <Border Grid.Column="0" Classes="boxedList" Margin="0,0,6,0">
                                <controls:InteractiveMapCanvas x:Name="MapCanvasFacilities" />
                            </Border>

                            <!-- Right: Grouped Clusters List -->
                            <Border Grid.Column="1" Classes="boxedList" Margin="6,0,0,0">
                                <ListBox x:Name="LstClusters" Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RuleBrush}"
                                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="12" Margin="3">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Header}" Classes="heading" />
                                                    <TextBlock Text="{Binding BoundsInfo}" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding CohesionInfo}" Classes="mono" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ==========================================================
                     TAB 5: VERIFICATION QUEUE & AUDIT TRAIL
                     ========================================================== -->
                <TabItem Header="5. Audit and Signoff">
                    <Grid RowDefinitions="Auto, *" Margin="2">
                        <Border Grid.Row="0" Classes="card" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Verified Intelligence Queue and W3C PROV-O Audit Trail" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontBodyLg}" />
                                    <TextBlock Text="Review verified analyst decisions and export cryptographically signed W3C PROV-O GeoJSON reports." FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Rocchio Feedback Rerank" Margin="0,0,8,0" Padding="14,8" Click="OnRerankClicked" ToolTip.Tip="Apply Rocchio relevance feedback using confirmed decisions to adapt retrieval embeddings" />
                                <Button Grid.Column="2" Classes="suggested" Content="Export W3C PROV-O GeoJSON" FontWeight="Bold" Padding="14,8" Click="OnExportGeoJsonClicked" ToolTip.Tip="Export an evidentiary W3C PROV-O compliant GeoJSON audit report with SHA-256 integrity hashes" />
                            </Grid>
                        </Border>

                        <!-- Work Queue Overview & Detailed Audit Log -->
                        <Border Grid.Row="1" Classes="boxedList">
                            <ListBox x:Name="LstReviewQueue" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RuleBrush}"
                                                BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="12" Margin="3">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding StatusBadge}" FontWeight="Bold" Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="{DynamicResource FontBodyLg}" />
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontBodyLg}" />
                                                    <TextBlock Text="{Binding AuditDetails}" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ConfidenceText}" Classes="mono" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ==============================================================
                 BOTTOM STATUSBAR & TELEMETRY DOCK (ROW 2)
                 Displays archive indexing metrics, candidates, AOI, and sensor specs
                 ============================================================== -->
            <Border Grid.Row="2" Classes="statusbar">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Left: Archive Telemetry & Candidates -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <lucide:Lucide Icon="{x:Static licon:LucideIconNames.Database}" Width="13" Height="13" StrokeThickness="2" StrokeBrush="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTelemetryArchive" Text="128 satellite images loaded" Classes="mono" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Rectangle Width="1" Height="14" Fill="{DynamicResource RuleBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource CandidateBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtTelemetryCandidates" Text="no candidates" Classes="mono" FontSize="{DynamicResource FontMicro}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Active Workflow Stage Indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusPill}" Padding="10,2">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Stage:" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtActiveWorkflowPhase" Text="1. Find Images" FontWeight="SemiBold" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Sensor Specifications & Air-Gapped Engine Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTelemetrySensor" Text="Sentinel-2 MSI &#x2022; 10m GSD" Classes="mono" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <Rectangle Width="1" Height="14" Fill="{DynamicResource RuleBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource VerifiedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Air-Gapped Sovereign" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- GNOME DIALOG SHEET: OUT-OF-COVERAGE / MISSING DATASET MODAL -->
        <!-- ========================================================================= -->
        <Border x:Name="DlgMissingDataModal" IsVisible="False" Background="#99000000" ZIndex="999">
            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusCard}" Padding="24" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 12 36 #80000000">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Background="{DynamicResource CandidateSurfaceBrush}" BorderBrush="{DynamicResource CandidateBrush}" BorderThickness="1" CornerRadius="18" Width="36" Height="36">
                                <lucide:Lucide Icon="{x:Static licon:LucideIconNames.TriangleAlert}" Width="18" Height="18" StrokeThickness="2" StrokeBrush="{DynamicResource CandidateBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Missing Satellite Coverage / Out-of-Bounds Query" Classes="heading" />
                                <TextBlock Text="No indexed observations exist for the requested location or timeframe." FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="flat" Click="OnModalDismissClicked" ToolTip.Tip="Close dialog (Esc)" VerticalAlignment="Top" Padding="6">
                            <lucide:Lucide Icon="{x:Static licon:LucideIconNames.X}" Width="16" Height="16" StrokeThickness="2" StrokeBrush="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Diagnostics & Active Archive Comparison Box -->
                    <Border Classes="cardCompact">
                        <Grid ColumnDefinitions="*, 1, *">
                            <!-- Left: Requested Query -->
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                                <TextBlock Text="REQUESTED QUERY" Classes="sectionHeader" />
                                <TextBlock x:Name="TxtModalQueryCoords" Text="Coordinates: (40.7128&#176;N, -74.0060&#176;E)" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TxtModalQueryRadius" Text="Search Radius: 10.0 km" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtModalQueryTime" Text="Time Interval: 2022-01-01 to 2022-12-31" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtModalQueryStatus" Text="Status: 0 scenes indexed for this spatiotemporal domain" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource RejectedBrush}" FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- Divider -->
                            <Rectangle Grid.Column="1" Fill="{DynamicResource RuleBrush}" />

                            <!-- Right: Current Active Coverage -->
                            <StackPanel Grid.Column="2" Spacing="6" Margin="12,0,0,0">
                                <TextBlock Text="ACTIVE ARCHIVE COVERAGE" Classes="sectionHeader" />
                                <TextBlock x:Name="TxtModalArchiveAoi" Text="Active AOI: New Delhi (28.58&#176;N - 28.62&#176;N, 77.19&#176;E - 77.23&#176;E)" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TxtModalArchiveEpochs" Text="Archive Epochs: 2024-01-10 to 2024-04-25 (Sentinel-2 L2A)" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtModalArchiveResolution" Text="Sensor: Sentinel-2 MSI (10m GSD Multi-Spectral)" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Status: Fully calibrated multi-temporal archive active" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource VerifiedBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Problem Explanation & Ingestion Request -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="How would you like to proceed?" FontWeight="SemiBold" FontSize="{DynamicResource FontBody}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="To analyze this geographic region or time period, please ingest an external GeoTIFF / STAC scene, or generate an on-the-fly calibrated synthetic Sentinel-2 AOI centered at your requested coordinates so you can verify changes anywhere in the world."
                                   FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Button Grid.Column="0" Content="Reset to Active Archive AOI"
                                Padding="12,7" FontSize="{DynamicResource FontMicro}" Click="OnModalResetToActiveCoverageClicked"
                                ToolTip.Tip="Reset coordinates to New Delhi baseline where satellite data is active" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="Ingest GeoTIFF..."
                                    Classes="quiet" Padding="12,7" FontSize="{DynamicResource FontMicro}" Click="OnModalIngestFileClicked"
                                    ToolTip.Tip="Select an external GeoTIFF satellite raster to ingest into the archive" />
                            <Button Content="Generate Calibrated AOI for Location"
                                    Classes="suggested" Padding="14,7" FontSize="{DynamicResource FontMicro}" Click="OnModalGenerateSyntheticSceneClicked"
                                    ToolTip.Tip="Generate and index on-the-fly multi-temporal satellite scenes at the queried coordinates" />
                            <Button Content="Dismiss"
                                    Classes="flat" Padding="10,7" FontSize="{DynamicResource FontMicro}" Click="OnModalDismissClicked" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</suki:SukiWindow>
