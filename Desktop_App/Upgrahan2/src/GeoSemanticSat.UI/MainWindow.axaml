<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GeoSemanticSat.UI.MainWindow"
        Title="GeoSemanticSat - Satellite Semantic Retrieval &amp; Multi-Temporal Change Analysis Studio"
        Width="1320" Height="890"
        WindowStartupLocation="CenterScreen"
        Background="#09090B">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Top Title Bar (Matte Black Theme) -->
        <Border Grid.Row="0" Background="#111114" BorderBrush="#222227" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Background="#1C1C21" CornerRadius="8" Width="42" Height="42" BorderBrush="#2E2E36" BorderThickness="1">
                        <TextBlock Text="🛰️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="GeoSemanticSat" FontWeight="Bold" FontSize="17" Foreground="#FAFAFA" />
                            <Border Background="#222228" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="v2.5 ANALYST WORKFLOW STUDIO" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Ministry of Defence (MoD) / Indian Army (DGIS) • Earth Observation Intelligence (PS-26227)" FontSize="11" Foreground="#71717A" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#141417" BorderBrush="#24242A" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="Status: 100% Offline Air-Gapped Mode • Ready" FontSize="12" Foreground="#D4D4D8" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnLoadGeoTiff" Content="📂 Ingest GeoTIFF" Background="#10B981" Foreground="#09090B" Padding="14,8" FontWeight="Bold" CornerRadius="6" Click="OnLoadGeoTiffClicked" ToolTip.Tip="Ingest an external GeoTIFF multi-band satellite raster into the search index" />
                    <Button x:Name="BtnQuickBenchmark" Content="▶ Run Benchmark Suite" Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46" BorderThickness="1" Padding="14,8" FontWeight="SemiBold" CornerRadius="6" Click="OnRunBenchmarkClicked" ToolTip.Tip="Run the automated multi-temporal evaluation benchmark suite" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- OPERATIONAL MISSION WORKFLOW RIBBON -->
        <Border Grid.Row="1" Background="#0D0D10" BorderBrush="#1C1C22" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Current Workflow Phase Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="STAGE:" FontSize="10" FontWeight="Bold" Foreground="#71717A" VerticalAlignment="Center" />
                    <Border Background="#1A1A22" CornerRadius="4" Padding="8,3" BorderBrush="#2B2B38" BorderThickness="1">
                        <TextBlock x:Name="TxtActiveWorkflowPhase" Text="Step 1: Semantic Concept Discovery" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- 5-Step Connected Interactive Stepper -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Step 1 Button -->
                    <Button x:Name="BtnStep1" Click="OnNavigateToStepClicked" Tag="0" Background="#18181B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border x:Name="BadgeStep1Icon" Background="#2563EB" CornerRadius="9" Width="18" Height="18">
                                <TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="TxtStep1Label" Text="Discover Concepts" FontSize="11" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                            <Border Background="#27272A" CornerRadius="6" Padding="5,1">
                                <TextBlock x:Name="BadgeStep1Count" Text="0" FontSize="10" Foreground="#A1A1AA" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="➔" FontSize="12" Foreground="#3F3F46" VerticalAlignment="Center" />

                    <!-- Step 2 Button -->
                    <Button x:Name="BtnStep2" Click="OnNavigateToStepClicked" Tag="1" Background="#141417" BorderBrush="#27272A" BorderThickness="1" CornerRadius="16" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border x:Name="BadgeStep2Icon" Background="#27272A" CornerRadius="9" Width="18" Height="18">
                                <TextBlock Text="2" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="TxtStep2Label" Text="Target Coordinates" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                            <Border Background="#27272A" CornerRadius="6" Padding="5,1">
                                <TextBlock x:Name="BadgeStep2Count" Text="0" FontSize="10" Foreground="#71717A" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="➔" FontSize="12" Foreground="#3F3F46" VerticalAlignment="Center" />

                    <!-- Step 3 Button -->
                    <Button x:Name="BtnStep3" Click="OnNavigateToStepClicked" Tag="2" Background="#141417" BorderBrush="#27272A" BorderThickness="1" CornerRadius="16" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border x:Name="BadgeStep3Icon" Background="#27272A" CornerRadius="9" Width="18" Height="18">
                                <TextBlock Text="3" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="TxtStep3Label" Text="Spectral Verification" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                            <Border Background="#27272A" CornerRadius="6" Padding="5,1">
                                <TextBlock x:Name="BadgeStep3Count" Text="4 Changes" FontSize="10" Foreground="#F59E0B" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="➔" FontSize="12" Foreground="#3F3F46" VerticalAlignment="Center" />

                    <!-- Step 4 Button -->
                    <Button x:Name="BtnStep4" Click="OnNavigateToStepClicked" Tag="3" Background="#141417" BorderBrush="#27272A" BorderThickness="1" CornerRadius="16" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border x:Name="BadgeStep4Icon" Background="#27272A" CornerRadius="9" Width="18" Height="18">
                                <TextBlock Text="4" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="TxtStep4Label" Text="Group Facilities" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                            <Border Background="#27272A" CornerRadius="6" Padding="5,1">
                                <TextBlock x:Name="BadgeStep4Count" Text="0" FontSize="10" Foreground="#71717A" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="➔" FontSize="12" Foreground="#3F3F46" VerticalAlignment="Center" />

                    <!-- Step 5 Button -->
                    <Button x:Name="BtnStep5" Click="OnNavigateToStepClicked" Tag="4" Background="#141417" BorderBrush="#27272A" BorderThickness="1" CornerRadius="16" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border x:Name="BadgeStep5Icon" Background="#27272A" CornerRadius="9" Width="18" Height="18">
                                <TextBlock Text="5" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="TxtStep5Label" Text="Audit &amp; Signoff" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                            <Border Background="#27272A" CornerRadius="6" Padding="5,1">
                                <TextBlock x:Name="BadgeStep5Count" Text="0 Verified" FontSize="10" Foreground="#34D399" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Quick Advance Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BtnNextStage" Click="OnAdvanceWorkflowClicked" Content="Next: Target Coordinates ➔" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" CornerRadius="6" Padding="14,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl x:Name="MainTabControl" Grid.Row="2" Margin="12" Background="Transparent" SelectionChanged="OnMainTabSelectionChanged">
            <!-- TAB 1: NATURAL LANGUAGE IMAGERY SEARCH -->
            <TabItem Header="🔍 1. Discover Concepts">
                <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="10">
                    
                    <!-- Descriptive Guide Card -->
                    <Border Grid.Row="0" Background="#131316" BorderBrush="#222227" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="💡" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Search Archive by Concept: Type free-text tactical queries. The AI multi-spectral vision encoder matches physical terrain features directly without needing coordinates."
                                       FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Search Input & Quick Queries -->
                    <StackPanel Grid.Row="1" Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox x:Name="TxtSearchQuery" Watermark="Type natural language query (e.g. 'newly built structures near a river', 'soil clearance', 'airfield runway')..."
                                     FontSize="14" Padding="12" Background="#141417" Foreground="#FAFAFA" BorderBrush="#2C2C34" CornerRadius="6" />
                            <Button Grid.Column="1" x:Name="BtnSearch" Content="🔍 Search Archive" Margin="10,0,0,0" Padding="18,12"
                                    Background="#3B82F6" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="6" Click="OnSearchClicked" />
                        </Grid>

                        <!-- Quick Query Chips -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Quick Concepts:" VerticalAlignment="Center" FontSize="11" Foreground="#71717A" FontWeight="SemiBold" />
                            <Button Content="🏗️ Structures near river" Tag="newly built structures near a river" Click="OnQuickQueryClicked" FontSize="11" Background="#1A1A1E" Foreground="#D4D4D8" BorderBrush="#27272E" BorderThickness="1" CornerRadius="4" Padding="8,4" />
                            <Button Content="🚛 Vehicle concentrations" Tag="large vehicle concentrations on open ground" Click="OnQuickQueryClicked" FontSize="11" Background="#1A1A1E" Foreground="#D4D4D8" BorderBrush="#27272E" BorderThickness="1" CornerRadius="4" Padding="8,4" />
                            <Button Content="✈️ Airfield &amp; runway" Tag="airfield runway with aircraft" Click="OnQuickQueryClicked" FontSize="11" Background="#1A1A1E" Foreground="#D4D4D8" BorderBrush="#27272E" BorderThickness="1" CornerRadius="4" Padding="8,4" />
                            <Button Content="🚜 Deforestation / cleared land" Tag="deforestation or cleared land" Click="OnQuickQueryClicked" FontSize="11" Background="#1A1A1E" Foreground="#D4D4D8" BorderBrush="#27272E" BorderThickness="1" CornerRadius="4" Padding="8,4" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Filter Bar with Visual Mode Guide -->
                    <Border Grid.Row="2" Background="#141417" CornerRadius="6" Padding="12" Margin="0,10,0,10" BorderBrush="#222227" BorderThickness="1">
                        <Grid RowDefinitions="Auto, Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto, Auto, *">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
                                    <TextBlock Text="Satellite Sensor:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="12" />
                                    <ComboBox x:Name="CmbSensorFilter" SelectedIndex="0" Width="150" Background="#1A1A1E" Foreground="#FAFAFA">
                                        <ComboBoxItem Content="All Platforms" />
                                        <ComboBoxItem Content="Sentinel-2 Optical" />
                                        <ComboBoxItem Content="Sentinel-1 SAR" />
                                        <ComboBoxItem Content="Landsat 8/9" />
                                        <ComboBoxItem Content="ISRO Bhuvan" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
                                    <TextBlock Text="Visualization Mode:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="12" />
                                    <ComboBox x:Name="CmbRenderMode" SelectedIndex="0" Width="190" Background="#1A1A1E" Foreground="#FAFAFA" SelectionChanged="OnRenderModeChanged">
                                        <ComboBoxItem Content="True Color (RGB)" />
                                        <ComboBoxItem Content="False Color (NIR / IR)" />
                                        <ComboBoxItem Content="SWIR Geological (B11/B8/B4)" />
                                        <ComboBoxItem Content="NDVI Vegetation Map" />
                                        <ComboBoxItem Content="NDWI Water Boundary" />
                                        <ComboBoxItem Content="NDBI Built-Up Infrastructure" />
                                        <ComboBoxItem Content="SAR Radar Backscatter (C-Band)" />
                                        <ComboBoxItem Content="Thermal IR Heat Signature" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
                                    <TextBlock Text="Top K Results:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="12" />
                                    <NumericUpDown x:Name="NumTopK" Value="10" Minimum="1" Maximum="100" Width="90" Background="#1A1A1E" Foreground="#FAFAFA" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Min Quality (%):" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="12" />
                                    <Slider x:Name="SldMinQuality" Value="50" Minimum="0" Maximum="100" Width="110" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Color Legend for Render Modes -->
                            <Border Grid.Row="1" Background="#0C0C0E" CornerRadius="4" Padding="8,4" Margin="0,8,0,0" BorderBrush="#1C1C20" BorderThickness="1">
                                <TextBlock Text="🎨 Mode Interpretation: [True Color: Natural RGB vision]  •  [False Color IR: Crimson Red = Living Vegetation, Black = Water, Cyan = Concrete]  •  [NDVI: Green = Forest, Yellow = Crops, Brown = Bare Soil]"
                                           FontSize="11" Foreground="#71717A" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Visual Results Grid -->
                    <ListBox Grid.Row="3" x:Name="LstSearchResults" Background="#0C0C0E" BorderBrush="#1F1F24" BorderThickness="1" CornerRadius="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141417" BorderBrush="#24242A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <!-- Visual Thumbnail Preview -->
                                        <Border Grid.Column="0" Width="108" Height="108" Background="#000000" CornerRadius="4" ClipToBounds="True" Margin="0,0,14,0" BorderBrush="#3B82F6" BorderThickness="1">
                                            <Image Source="{Binding ImagePreview}" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Metadata and Details -->
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding SimilarityBadge}" FontWeight="Bold" FontSize="11" Foreground="#93C5FD" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#FAFAFA" FontSize="13" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#A1A1AA" />
                                            <TextBlock Text="{Binding Coordinates}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SpectralInfo}" FontSize="11" Foreground="#34D399" />
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="🔎 Similar" Tag="{Binding PatchId}" Click="OnFindSimilarClicked"
                                                    Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10,5" FontSize="11" ToolTip.Tip="Search for other patches in the archive that visually and semantically match this one" />
                                            <Button Content="🎯 To Step 2 (Coords)" Tag="{Binding PatchId}" Click="OnInspectPatchChangeClicked"
                                                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="4" Padding="10,5" FontSize="11" ToolTip.Tip="Transfer coordinates to Step 2 to search by radius and date" />
                                            <Button Content="🔬 Changes in Step 3" Tag="{Binding PatchId}" Click="OnInspectPatchDirectToStep3Clicked"
                                                    Background="#10B981" Foreground="#09090B" FontWeight="Bold" CornerRadius="4" Padding="10,5" FontSize="11" ToolTip.Tip="Directly open Step 3 to analyze multi-temporal changes in this patch's area" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Tab 1 Bottom Workflow Bar -->
                    <Border Grid.Row="4" Background="#111114" BorderBrush="#24242A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="💡 Step 1 Complete?" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                                <TextBlock Text="Found candidate patches? Advance to Step 2 to target coordinates or jump directly to Step 3 for change physics." FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="➔ Advance to Step 2: Target Coordinates" Click="OnAdvanceWorkflowClicked" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="4" Padding="12,6" FontSize="11" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="🔬 Direct to Step 3: Change Analysis" Click="OnDirectToStep3Clicked" Background="#10B981" Foreground="#09090B" FontWeight="Bold" CornerRadius="4" Padding="12,6" FontSize="11" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: TARGET COORDINATE & CHANGE SEARCH -->
            <TabItem Header="🎯 2. Target Coordinates">
                <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="10">
                    
                    <!-- Descriptive Guide Card -->
                    <Border Grid.Row="0" Background="#131316" BorderBrush="#222227" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="💡" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Search by Location &amp; Time: Enter target Latitude/Longitude and radius to inspect verified changes with side-by-side Before (T₁) and After (T₂) imagery."
                                       FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Advanced Spatial & Temporal Search Parameters -->
                    <Border Grid.Row="1" Background="#141417" CornerRadius="6" Padding="14" Margin="0,0,0,12" BorderBrush="#222227" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <!-- Lat/Long/Radius & Time Controls -->
                            <Grid ColumnDefinitions="*, *, *, *, Auto">
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Center Latitude (°N):" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3" />
                                    <TextBox x:Name="TxtSearchLat" Text="28.60500" Background="#1A1A1E" Foreground="#FAFAFA" BorderBrush="#2B2B32" CornerRadius="4" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Center Longitude (°E):" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3" />
                                    <TextBox x:Name="TxtSearchLon" Text="77.20800" Background="#1A1A1E" Foreground="#FAFAFA" BorderBrush="#2B2B32" CornerRadius="4" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Search Radius (km):" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3" />
                                    <TextBox x:Name="TxtSearchRadius" Text="10.0" Background="#1A1A1E" Foreground="#FAFAFA" BorderBrush="#2B2B32" CornerRadius="4" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock Text="Target Change Classification:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3" />
                                    <ComboBox x:Name="CmbChangeTypeFilter" SelectedIndex="0" HorizontalAlignment="Stretch" Background="#1A1A1E" Foreground="#FAFAFA">
                                        <ComboBoxItem Content="All Supported Types" />
                                        <ComboBoxItem Content="Construction (New Built Structures)" />
                                        <ComboBoxItem Content="Clearance (Vegetation / Earthworks)" />
                                        <ComboBoxItem Content="Water-Extent Variation (Flooding / Drying)" />
                                        <ComboBoxItem Content="Road / Linear Infrastructure" />
                                        <ComboBoxItem Content="Activity Concentration (Vehicles)" />
                                    </ComboBox>
                                </StackPanel>

                                <Button Grid.Column="4" x:Name="BtnExecuteSpatiotemporalSearch" Content="🔍 Search Changes"
                                        Background="#10B981" Foreground="#09090B" FontWeight="Bold" Padding="18,10" VerticalAlignment="Bottom" CornerRadius="6"
                                        Click="OnExecuteSpatiotemporalSearchClicked" />
                            </Grid>

                            <!-- Preset Sector Quick Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Preset Sectors:" VerticalAlignment="Center" FontSize="11" Foreground="#71717A" FontWeight="SemiBold" />
                                <Button Content="📍 Sector Alpha (Facility Ground: 28.605°N, 77.208°E)" Tag="28.6050,77.2080,5.0,Construction" Click="OnPresetSectorClicked" FontSize="11" Background="#1A1A1E" Foreground="#D4D4D8" BorderBrush="#27272E" BorderThickness="1" CornerRadius="4" Padding="8,4" />
                                <Button Content="📍 Sector Bravo (River Corridor: 28.592°N, 77.203°E)" Tag="28.5920,77.2030,5.0,WaterExtentVariation" Click="OnPresetSectorClicked" FontSize="11" Background="#1A1A1E" Foreground="#D4D4D8" BorderBrush="#27272E" BorderThickness="1" CornerRadius="4" Padding="8,4" />
                                <Button Content="📍 Sector Charlie (Clearance Plot: 28.604°N, 77.218°E)" Tag="28.6040,77.2180,5.0,Clearance" Click="OnPresetSectorClicked" FontSize="11" Background="#1A1A1E" Foreground="#D4D4D8" BorderBrush="#27272E" BorderThickness="1" CornerRadius="4" Padding="8,4" />
                            </StackPanel>

                            <!-- Change Type Legend -->
                            <Border Background="#0C0C0E" CornerRadius="4" Padding="8,4" BorderBrush="#1C1C20" BorderThickness="1">
                                <TextBlock Text="🏷️ Classification Legend: [🔴 Construction: Concrete/Buildings]  •  [🟡 Clearance: Deforestation/Earthworks]  •  [🔵 Water Shift: Inundation/Drying]  •  [🟣 Road: Linear Tracks]"
                                           FontSize="11" Foreground="#71717A" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Results List with Before & After Visual Inspection -->
                    <ListBox Grid.Row="2" x:Name="LstSpatiotemporalResults" Background="#0C0C0E" BorderBrush="#1F1F24" BorderThickness="1" CornerRadius="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141417" BorderBrush="#24242A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3">
                                    <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                                        <!-- Before Thumbnail -->
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0" HorizontalAlignment="Center">
                                            <TextBlock Text="📅 Baseline (T₁)" FontSize="10" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,0,0,4" FontWeight="SemiBold" />
                                            <Border Width="96" Height="96" Background="#000000" CornerRadius="4" ClipToBounds="True" BorderBrush="#3F3F46" BorderThickness="1">
                                                <Image Source="{Binding BeforePreview}" Stretch="UniformToFill" />
                                            </Border>
                                        </StackPanel>

                                        <!-- After Thumbnail -->
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0" HorizontalAlignment="Center">
                                            <TextBlock Text="📅 Observed (T₂)" FontSize="10" Foreground="#F87171" HorizontalAlignment="Center" Margin="0,0,0,4" FontWeight="SemiBold" />
                                            <Border Width="96" Height="96" Background="#000000" CornerRadius="4" ClipToBounds="True" BorderBrush="#EF4444" BorderThickness="1">
                                                <Image Source="{Binding AfterPreview}" Stretch="UniformToFill" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="{Binding TypeBadgeColor}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding ChangeType}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#FAFAFA" FontSize="13" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DistanceInfo}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding EarliestOnsetInfo}" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SpectralMetrics}" FontSize="11" Foreground="#A1A1AA" />
                                        </StackPanel>

                                        <!-- Action Confirm/Reject & Step Navigation -->
                                        <StackPanel Grid.Column="3" Spacing="5" VerticalAlignment="Center">
                                            <Button Content="🔬 Deep Inspect (Step 3)" Tag="{Binding Id}" Click="OnInspectSpatiotemporalInStep3Clicked"
                                                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="4" Padding="10,5" FontSize="11" ToolTip.Tip="Open this candidate directly in Step 3's high-detail focused site inspector" />
                                            <Button Content="✓ Confirm (Step 5)" Tag="{Binding Id}" Click="OnConfirmChangeClicked"
                                                    Background="#065F46" Foreground="#ECFDF5" BorderBrush="#047857" BorderThickness="1" CornerRadius="4" Padding="10,5" FontSize="11" ToolTip.Tip="Confirm this candidate into the Step 5 verification queue" />
                                            <Button Content="✗ Reject" Tag="{Binding Id}" Click="OnRejectChangeClicked"
                                                    Background="#7F1D1D" Foreground="#FEF2F2" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="4" Padding="10,5" FontSize="11" ToolTip.Tip="Mark candidate as false alarm" />
                                            <Button Content="📍 Pin to Facility (Step 4)" Tag="{Binding Id}" Click="OnPinSpatiotemporalToStep4Clicked"
                                                    Background="#581C87" Foreground="#F3E8FF" BorderBrush="#7E22CE" BorderThickness="1" CornerRadius="4" Padding="10,5" FontSize="11" ToolTip.Tip="Queue this site into Step 4 for unsupervised spatial-semantic clustering" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Tab 2 Bottom Workflow Bar -->
                    <Border Grid.Row="3" Background="#111114" BorderBrush="#24242A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Button Grid.Column="0" Content="◀ Back to Step 1: Discover Concepts" Click="OnBackToStep1Clicked" Background="#1E1E24" Foreground="#D4D4D8" BorderBrush="#2B2B32" BorderThickness="1" CornerRadius="4" Padding="12,6" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="Step 2 Coordinates Set: Ready to perform physics-based false-alarm suppression and spectral change verification." FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Button Grid.Column="2" Content="➔ Proceed to Step 3: Spectral Verification" Click="OnAdvanceWorkflowClicked" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="4" Padding="12,6" FontSize="11" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: MULTI-TEMPORAL CHANGE & HEATMAP INSPECTOR -->
            <TabItem Header="🔄 3. Spectral Verification">
                <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="10">
                    <!-- Control Header with Spectral & EM Mode Selector -->
                    <Border Grid.Row="0" Background="#141417" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="#222227" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Automated Multi-Temporal Scene Comparator &amp; Change Heatmap Engine" FontWeight="Bold" Foreground="#FAFAFA" FontSize="14" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <CheckBox x:Name="ChkRrn" Content="PIF Radiometric Normalization" IsChecked="True" Foreground="#D4D4D8" FontSize="11" />
                                    <CheckBox x:Name="ChkQualityMask" Content="Cloud &amp; Shadow Masking" IsChecked="True" Foreground="#D4D4D8" FontSize="11" />
                                    <CheckBox x:Name="ChkJitter" Content="Co-Registration Jitter Suppression" IsChecked="True" Foreground="#D4D4D8" FontSize="11" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Spectral & Electromagnetic Render Mode Selector -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="Spectral / EM View:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="12" FontWeight="SemiBold" />
                                <ComboBox x:Name="CmbChangeSpectralMode" SelectedIndex="0" Width="210" Background="#1A1A1E" Foreground="#FAFAFA" SelectionChanged="OnChangeSpectralModeChanged">
                                    <ComboBoxItem Content="True Color (RGB Composite)" />
                                    <ComboBoxItem Content="False Color Infrared (NIR)" />
                                    <ComboBoxItem Content="SWIR Geological (B11/B8/B4)" />
                                    <ComboBoxItem Content="NDBI Built-Up &amp; Concrete" />
                                    <ComboBoxItem Content="NDVI Vegetation Loss Map" />
                                    <ComboBoxItem Content="NDWI Water Extent Boundary" />
                                    <ComboBoxItem Content="SAR Radar Backscatter (C-Band)" />
                                    <ComboBoxItem Content="Thermal IR Heat Radiance" />
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="3" x:Name="BtnRunChangeDetection" Content="▶ Compute Change Heatmap"
                                    Background="#10B981" Foreground="#09090B" FontWeight="Bold" Padding="16,10" VerticalAlignment="Center" CornerRadius="6"
                                    Click="OnRunChangeDetectionClicked" />
                        </Grid>
                    </Border>

                    <!-- Triple Visual Presentation: T1 vs T2 vs Heatmap -->
                    <Border Grid.Row="1" Background="#111114" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#222227" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, *, *">
                                <!-- View 1: Baseline T1 -->
                                <StackPanel Grid.Column="0" Margin="4">
                                    <TextBlock Text="1. Baseline Imagery (T₁: 2024-01-10)" FontWeight="Bold" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                    <Border Background="#000000" CornerRadius="4" Height="200" ClipToBounds="True" BorderBrush="#2B2B32" BorderThickness="1">
                                        <Image x:Name="ImgBaselineT1" Stretch="Uniform" />
                                    </Border>
                                </StackPanel>

                                <!-- View 2: Target T2 -->
                                <StackPanel Grid.Column="1" Margin="4">
                                    <TextBlock Text="2. Target Observation (T₂: 2024-03-20)" FontWeight="Bold" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                    <Border Background="#000000" CornerRadius="4" Height="200" ClipToBounds="True" BorderBrush="#2B2B32" BorderThickness="1">
                                        <Image x:Name="ImgTargetT2" Stretch="Uniform" />
                                    </Border>
                                </StackPanel>

                                <!-- View 3: Change Heatmap Overlay -->
                                <StackPanel Grid.Column="2" Margin="4">
                                    <TextBlock Text="3. Change Heatmap &amp; Boundary Detection" FontWeight="Bold" Foreground="#F59E0B" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                    <Border Background="#000000" CornerRadius="4" Height="200" ClipToBounds="True" BorderBrush="#F59E0B" BorderThickness="1">
                                        <Image x:Name="ImgChangeHeatmap" Stretch="Uniform" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Color Legend Bar -->
                            <Border Background="#09090B" CornerRadius="4" Padding="8,4" BorderBrush="#1C1C20" BorderThickness="1">
                                <TextBlock Text="🔴 Red: New Construction / Concrete Pad   🟡 Amber: Cleared Forest / Soil Earthworks   🔵 Cyan: Water Boundary Variation   🟣 Purple: Linear Tracks"
                                           FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Interactive Split View: Detected Changes List (Left) & Focused Site Inspector (Right) -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, 460">
                        <!-- Left: List of Detected Changes -->
                        <Grid Grid.Column="0" RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="📋 Detected Ground Changes (Click any item to inspect in high detail):" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" Margin="2,0,0,6" />
                            <ListBox Grid.Row="1" x:Name="LstChangeResults" Background="#0C0C0E" BorderBrush="#1F1F24" BorderThickness="1" CornerRadius="6" SelectionChanged="OnChangeSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#141417" BorderBrush="#24242A" BorderThickness="1" CornerRadius="6" Padding="10" Margin="2">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <Border Grid.Column="0" Background="{Binding TypeBadgeColor}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Type}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#FAFAFA" FontSize="13" />
                                                    <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="#A1A1AA" />
                                                    <TextBlock Text="{Binding MetricsSummary}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding EarliestObservationText}" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                                    <Button Content="✓ Confirm" Tag="{Binding Id}" Click="OnConfirmChangeClicked" Background="#065F46" Foreground="#ECFDF5" BorderBrush="#047857" BorderThickness="1" CornerRadius="4" Padding="8,5" FontSize="11" />
                                                    <Button Content="✗ Reject" Tag="{Binding Id}" Click="OnRejectChangeClicked" Background="#7F1D1D" Foreground="#FEF2F2" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="4" Padding="8,5" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- Right: Interactive Focused Site Inspector -->
                        <Border Grid.Column="1" Margin="10,0,0,0" Background="#141417" BorderBrush="#26262D" BorderThickness="1" CornerRadius="6" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="10">
                                    <!-- Header -->
                                    <Border Background="#1C1C22" CornerRadius="4" Padding="10,6" BorderBrush="#2E2E38" BorderThickness="1">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="🔬 Focused Change Inspection Station" FontWeight="Bold" Foreground="#FAFAFA" FontSize="13" />
                                                <TextBlock x:Name="TxtFocusedTitle" Text="Select a change candidate to inspect" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" x:Name="BadgeFocusedType" Background="#27272A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtFocusedType" Text="INSPECTOR" FontSize="10" FontWeight="Bold" Foreground="#FAFAFA" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Zoomed 3-Panel Target Comparison -->
                                    <Grid ColumnDefinitions="*, *, *">
                                        <StackPanel Grid.Column="0" Margin="2">
                                            <TextBlock Text="🔍 Zoomed T₁" FontSize="10" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                            <Border Width="130" Height="100" Background="#000000" CornerRadius="4" ClipToBounds="True" BorderBrush="#3F3F46" BorderThickness="1">
                                                <Image x:Name="ImgFocusedT1" Stretch="Uniform" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="2">
                                            <TextBlock Text="🔍 Zoomed T₂" FontSize="10" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                            <Border Width="130" Height="100" Background="#000000" CornerRadius="4" ClipToBounds="True" BorderBrush="#EF4444" BorderThickness="1">
                                                <Image x:Name="ImgFocusedT2" Stretch="Uniform" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="2">
                                            <TextBlock Text="🎯 Reticle Overlay" FontSize="10" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                            <Border Width="130" Height="100" Background="#000000" CornerRadius="4" ClipToBounds="True" BorderBrush="#F59E0B" BorderThickness="1">
                                                <Image x:Name="ImgFocusedOverlay" Stretch="Uniform" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Spectral & Electromagnetic Shift Breakdown -->
                                    <Border Background="#0E0E11" CornerRadius="6" Padding="10" BorderBrush="#1F1F24" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="📊 Multi-Spectral Telemetry &amp; Index Shifts:" FontSize="11" FontWeight="Bold" Foreground="#D4D4D8" />

                                            <Grid ColumnDefinitions="*, *">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="Concrete / Built (ΔNDBI):" FontSize="10" Foreground="#71717A" />
                                                    <TextBlock x:Name="TxtFocusedDeltaNdbi" Text="-- " FontSize="11" Foreground="#EF4444" FontWeight="Bold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="Biomass Loss (ΔNDVI):" FontSize="10" Foreground="#71717A" />
                                                    <TextBlock x:Name="TxtFocusedDeltaNdvi" Text="-- " FontSize="11" Foreground="#F59E0B" FontWeight="Bold" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid ColumnDefinitions="*, *">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="Water Boundary (ΔNDWI):" FontSize="10" Foreground="#71717A" />
                                                    <TextBlock x:Name="TxtFocusedDeltaNdwi" Text="-- " FontSize="11" Foreground="#38BDF8" FontWeight="Bold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="Edge Sharpness (ΔSobel):" FontSize="10" Foreground="#71717A" />
                                                    <TextBlock x:Name="TxtFocusedDeltaGrad" Text="-- " FontSize="11" Foreground="#34D399" FontWeight="Bold" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Background="#16161B" CornerRadius="4" Padding="8,4" Margin="0,4,0,0">
                                                <TextBlock x:Name="TxtFocusedOnset" Text="Select a site above to review automated onset trajectory" FontSize="10" Foreground="#A1A1AA" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <Button Grid.Column="0" x:Name="BtnFocusedPivot" Content="🎯 Pivot to Tab 2" Background="#2563EB" Foreground="#FFFFFF" CornerRadius="4" Padding="10,6" FontSize="11" Click="OnFocusedPivotClicked" ToolTip.Tip="Open this exact site in Tab 2 with geographic coordinates pre-loaded" />
                                        <Button Grid.Column="1" x:Name="BtnFocusedConfirm" Content="✓ Confirm" Margin="6,0,0,0" Background="#065F46" Foreground="#ECFDF5" CornerRadius="4" Padding="12,6" FontSize="11" Click="OnFocusedConfirmClicked" />
                                        <Button Grid.Column="2" x:Name="BtnFocusedReject" Content="✗ Reject" Margin="6,0,0,0" Background="#7F1D1D" Foreground="#FEF2F2" CornerRadius="4" Padding="12,6" FontSize="11" Click="OnFocusedRejectClicked" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 4: GROUPED SITES & DEFENSE FACILITIES -->
            <TabItem Header="📍 Grouped Sites &amp; Facilities">
                <Grid RowDefinitions="Auto, *" Margin="10">
                    <Border Grid.Row="0" Background="#141417" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#222227" BorderThickness="1">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Unsupervised Spatial-Semantic Clustering (DBSCAN)" FontWeight="Bold" Foreground="#FAFAFA" FontSize="14" />
                                <TextBlock Text="Automatically group scattered change patches into unified operational facilities (e.g. forward bases, staging hubs, runways) without manual tagging." FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="📍 Group Archive Sites" Background="#8B5CF6" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,8" CornerRadius="6" Click="OnRunClusteringClicked" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="LstClusters" Background="#0C0C0E" BorderBrush="#1F1F24" BorderThickness="1" CornerRadius="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141417" BorderBrush="#24242A" BorderThickness="1" CornerRadius="6" Padding="14" Margin="3">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Header}" FontWeight="Bold" Foreground="#C4B5FD" FontSize="14" />
                                        <TextBlock Text="{Binding BoundsInfo}" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock Text="{Binding CohesionInfo}" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- TAB 5: VERIFICATION QUEUE & AUDIT TRAIL -->
            <TabItem Header="📋 Verification Queue &amp; Audit Trail">
                <Grid RowDefinitions="Auto, *" Margin="10">
                    <Border Grid.Row="0" Background="#141417" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#222227" BorderThickness="1">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Ranked Verification Queue &amp; W3C PROV-O Audit Trail" FontWeight="Bold" Foreground="#FAFAFA" FontSize="14" />
                                <TextBlock Text="Verify, reject, or flag candidates. 'Active Learning Rerank' updates AI embeddings using your decisions without retraining." FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="⚡ Teach AI (Rerank)" Background="#2563EB" Foreground="#FFFFFF" Margin="0,0,8,0" Padding="14,8" CornerRadius="6" Click="OnRerankClicked" ToolTip.Tip="Apply Rocchio relevance feedback using your confirmed/rejected decisions to steer model retrieval" />
                            <Button Grid.Column="2" Content="💾 Export W3C PROV-O GeoJSON" Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" CornerRadius="6" Click="OnExportGeoJsonClicked" ToolTip.Tip="Export an evidentiary W3C PROV-O compliant GeoJSON audit trail with cryptographic SHA-256 hashes" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="LstReviewQueue" Background="#0C0C0E" BorderBrush="#1F1F24" BorderThickness="1" CornerRadius="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141417" BorderBrush="#24242A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="2">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding StatusBadge}" FontWeight="Bold" Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#FAFAFA" FontSize="13" />
                                            <TextBlock Text="{Binding AuditDetails}" FontSize="11" Foreground="#A1A1AA" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ConfidenceText}" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
